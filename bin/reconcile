#!/usr/bin/env bash
# Rebuild status from disk + git. No watcher, no state of its own.
#   reconcile            one line per OPEN task in this repo (use at session start)
#   reconcile --all      include finished tasks
#   reconcile <task-id>  detail: resume point, direction, open questions, learnings, recent rows, workers, branches
#   reconcile --gate [--session S] [-t ID]   workers still running or finished without an `accept` ledger row, one line each; exit 0 clear, 1 outstanding
#                        scope: --session S = that session's workers across tasks (a closed task gates its live running ones only), else -t ID, else $DEVKIT_TASK
#   reconcile --wait [--session S] [-t ID]   poll every $DEVKIT_GATE_POLL s until none run, max $DEVKIT_WAIT s; then like --gate (timeout also exits 1)
set -u
here=$(dirname "$0"); . "$here/defaults" || { echo "reconcile: cannot load $here/defaults" >&2; exit 2; }; B=$("$here/ledger" base); TD=$B/tasks
cut_() { printf '%s' "$1" | cut -c1-"$2"; }
workers() { # task dir -> "running killed done failed" counts, or per-worker lines with -v
  local d=$1 mode=${2:-count} r=0 k=0 f=0 s st pid id
  for s in "$d"/run/*.status; do [ -f "$s" ] || continue; id=$(basename "$s" .status); read -r st pid _ < "$s"
    if [ "$st" = running ]; then if kill -0 "$pid" 2>/dev/null; then st=running; r=$((r+1)); else st=killed; k=$((k+1)); fi; else f=$((f+1)); fi # pitfall-ok: decimal-arith internal counters
    [ "$mode" = -v ] && printf '  %-14s %-9s %s\n' "$id" "$st" "$([ -s "$d/handoffs/$id.md" ] && echo "handoff: handoffs/$id.md" || echo "no handoff")"
  done
  [ "$mode" = count ] && echo "$r running, $k killed, $f finished"; }
rows() { tail -n +2 "$1/ledger.tsv"; }
lastrow() { rows "$1" | awk -F'\t' '$2!="prune"{r=$0} END{if(r!="")print r}'; } # prune is post-close housekeeping, never state

# outstanding workers of one task dir: running, or exited with no `accept` row newer than their last exit row (a respawned id is outstanding again); a closed task gates running workers only
gate_task() { # dir session-or-empty [closed=1]
  local d=$1 want=${2:-} closed=${3:-} s id st pid sess tid; tid=$(basename "$d")
  for s in "$d"/run/*.status; do [ -f "$s" ] || continue; id=$(basename "$s" .status)
    [ -s "$s" ] || continue # spawn writes the status file non-atomically; skip a half-written one
    read -r st pid _ < "$s"
    if [ -n "$want" ]; then sess=$(cat "$d/run/$id.session" 2>/dev/null); [ "$sess" = "$want" ] || continue; fi
    if [ "$st" = running ]; then if kill -0 "$pid" 2>/dev/null; then [ -e "$d/run/$id.detached" ] || echo "$id running  task=$tid"; continue; else st=killed; fi; fi
    [ -n "$closed" ] && continue # closed with done: only still-live running workers gate
    # (c) same rule as spawn --prune accepted(): an accept row newer than the worker's last spawn row
    awk -F'\t' -v id="$id" '$2=="spawn"{split($3,w," "); if(w[1]==id && w[2]!="nudge" && w[2]!="scout") ex=NR} $2=="accept"{split($3,w," "); if(w[1]==id) ac=NR} END{exit (ac>ex && ac>0)?0:1}' "$d/ledger.tsv" || echo "$id $st, unaccepted  task=$tid"
  done; }
gate() { # [--session S] [-t ID], any order; scope: session's workers, else -t ID, else $DEVKIT_TASK
  local want="" task=${DEVKIT_TASK:-} d out="" o closed
  while [ $# -gt 0 ]; do
    case $1 in
      --session) [ -n "${2:-}" ] || { echo "reconcile: --session needs a session id" >&2; exit 2; }; want=$2; shift 2;;
      -t) [ -n "${2:-}" ] || { echo "reconcile: -t needs a task id" >&2; exit 2; }; task=$2; shift 2;;
      *) shift;;
    esac
  done
  if [ -z "$want" ] && [ -z "$task" ]; then task=$("$here/ledger" current 2>/dev/null) || task=; fi
  if [ -n "$want" ]; then
    for d in "$TD"/*/; do d=${d%/}; [ -f "$d/ledger.tsv" ] || continue
      closed=""; [ "$(lastrow "$d" | cut -f2)" = done ] && closed=1 # closed task: gate_task reports running only
      o=$(gate_task "$d" "$want" "$closed"); [ -z "$o" ] || out+="$o"$'\n'; done
  else
    if [ -z "$task" ]; then
      m=$("$here/ledger" path 2>&1 >/dev/null)
      case $m in *"is closed (or gone)"*) echo "reconcile --gate: ${m#ledger: }" >&2;; *) echo "reconcile --gate: pass --session S, -t ID or set DEVKIT_TASK" >&2;; esac
      exit 2
    fi
    d=$TD/$task; [ -d "$d" ] || { echo "reconcile: unknown task '$task'" >&2; exit 2; }
    out=$(gate_task "$d" ""); [ -z "$out" ] || out+=$'\n'
  fi
  [ -z "$out" ] || printf '%s' "$out"; [ -z "$out" ]; }
wait_() { # same scope as gate; poll until nothing runs or DEVKIT_WAIT elapses
  local out rc cap=$DEVKIT_WAIT poll=$DEVKIT_GATE_POLL
  case $cap$poll in *[!0-9]*) echo "reconcile --wait: DEVKIT_WAIT and DEVKIT_GATE_POLL must be a whole number of seconds" >&2; exit 2;; esac
  [ "$poll" -gt 0 ] || { echo "reconcile --wait: DEVKIT_GATE_POLL must be at least 1" >&2; exit 2; }
  cap=$((10#$cap)); poll=$((10#$poll)) # force decimal: 08/09 are not octal
  SECONDS=0
  while :; do
    out=$(gate "$@"); rc=$?; [ $rc -ne 2 ] || exit 2
    printf '%s' "$out" | grep -q ' running ' || break
    if [ "$SECONDS" -ge "$cap" ]; then echo "reconcile --wait: timed out after ${cap}s, workers still running" >&2; break; fi
    sleep "$poll"
  done
  [ -z "$out" ] || printf '%s\n' "$out"; [ -z "$out" ]; }

case ${1:-} in
  -t) case ${3:-} in --gate|--wait) ;; *) echo "reconcile: -t goes with --gate or --wait" >&2; exit 2;; esac
    t=${2:-}; m=$3; shift 3; case $m in --gate) gate -t "$t" "$@"; exit $?;; *) wait_ -t "$t" "$@"; exit $?;; esac;;
  --gate) shift; gate "$@"; exit $?;;
  --wait) shift; wait_ "$@"; exit $?;;
  ""|--all)
    [ -d "$TD" ] && ls "$TD"/*/ledger.tsv >/dev/null 2>&1 || { echo "no tasks in this repo. Start one: bin/ledger start <slug>"; exit 0; }
    for d in "$TD"/*/; do d=${d%/}; id=$(basename "$d"); [ -f "$d/ledger.tsv" ] || continue
      row=$(lastrow "$d"); ph=$(printf '%s' "$row" | cut -f2); dec=$(printf '%s' "$row" | cut -f3)
      if [ "$ph" = done ]; then [ "${1:-}" = --all ] || continue; state=done; else state=open; fi
      printf '%s  %s  %s: %s  [%s]\n' "$id" "$state" "$ph" "$(cut_ "$dec" 60)" "$(workers "$d")"
    done
    n=$("$here/learn" count 2>/dev/null); [ "${n:-0}" -eq 0 ] || echo "learnings queued: $n (run dev-learn)";;
  *)
    d=$TD/$1; [ -d "$d" ] || { echo "reconcile: unknown task '$1'" >&2; exit 2; }
    echo "task $1"
    nx=$(rows "$d" | awk -F'\t' '$2=="next"' | tail -1)
    [ -n "$nx" ] && echo "resume: $(printf '%s' "$nx" | cut -f3)"
    S=$d/state.md
    if [ -f "$S" ]; then
      dir=$(awk '/^## /{sec=substr($0,4);next} sec=="Direction" && $0!=""{printf "%s%s",(n++?" / ":""),$0}' "$S"); [ -z "$dir" ] || echo "direction: $dir"
      oq=$(awk '/^## /{sec=substr($0,4);next} sec=="Open questions" && /^- /{c++; if(c<=3) print "  " $0}' "$S"); [ -z "$oq" ] || { echo "open questions:"; echo "$oq"; }
      lo=$(grep -c '^- \[ \] ' "$S"); lq=$(grep -c '^- \[~\] ' "$S"); [ $((lo+lq)) -eq 0 ] || echo "learnings: $lo open, $lq queued" # pitfall-ok: decimal-arith grep -c outputs, always decimal
      v=$(DEVKIT_TASK=$1 "$here/state" check 2>&1 | grep -c '^FAIL'); [ "$v" -eq 0 ] || echo "state: $v issue(s), run bin/state check"
    fi
    echo "recent:"; rows "$d" | tail -5 | awk -F'\t' '{printf "  %s %s: %s\n", substr($1,3), $2, substr($3,1,70)}'
    echo "workers:"; workers "$d" -v
    [ -f "$d/plan.json" ] && echo "plan: $(grep -c '"id"' "$d/plan.json") slices in plan.json"
    br=$(git branch --list "devkit/$1-*" 2>/dev/null | tr -d ' *+'); [ -n "$br" ] && echo "branches: $(echo $br)";;
esac
