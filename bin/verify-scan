#!/usr/bin/env bash
# Scan the working tree against BASE for weakened tests, test escapes and gate edits.
# Usage: bin/verify-scan [BASE]   BASE defaults to the merge-base of HEAD with origin/main, else main.
# One finding per line: weakened | test-escape | gate-edit. Exit 0 clean, 1 findings, 2 could not run.
set -u
ESCAPE_RE='[|][|] *true|(^|[;&[:space:]])exit 0([^0-9]|$)|(^|[^A-Za-z_])(SKIP|skip)([_[:space:]:=]|$)'
OK_RE='^[[:space:]]*ok[[:space:]]'

die() { echo "verify-scan: $*" >&2; exit 2; }
tmp=$(mktemp -d) || exit 2; trap 'rm -rf "$tmp"' EXIT
top=$(git rev-parse --show-toplevel 2>/dev/null) || die "not a git repo"
cd "$top" || exit 2

base=${1:-}
[ -n "$base" ] || base=$(git merge-base HEAD origin/main 2>/dev/null) || base=$(git merge-base HEAD main 2>/dev/null) || base=
[ -n "$base" ] && git rev-parse --verify -q "$base^{commit}" >/dev/null || die "cannot resolve a base (pass one, or create origin/main or main)"

# A temp index (base tree plus add -A) sees untracked files and renames; the real index is untouched.
export GIT_INDEX_FILE="$tmp/index"
git read-tree "$base" && git add -A || die "could not build a temp index"
git diff --cached -M --no-color --name-status "$base" > "$tmp/changes" || die "git diff failed"

# every file the close gate depends on: bin/ledger holds the whole done gate, bin/run writes the
# gate's evidence log, tests/run-all.sh is the suite the pass stands on, bin/defaults sets the knobs
is_gate() { case $1 in bin/verify|bin/verify-scan|bin/verify.budget|bin/ledger|bin/run|bin/defaults|tests/run-all.sh|tests/verify*.test.sh|tests/fixtures/verify/*) return 0;; esac; return 1; }
names() { sed -E 's/^[[:space:]]*ok[[:space:]]+("[^"]*"|[^[:space:]]+).*/\1/' | sort; }
test_files() { git ls-files "$1" 2>/dev/null | grep -E '^tests/[^/]*\.test\.sh$'; }

scan_gate() {
  local st p1 p2 p
  while IFS=$'\t' read -r st p1 p2; do
    for p in "$p1" "$p2"; do [ -n "$p" ] && is_gate "$p" && echo "gate-edit $p needs user approval"; done
  done < "$tmp/changes"
}

scan_escape() {
  local st p1 p2 bp np
  # Seed the file so awk's FNR==NR stays true even when no test file changed.
  printf '\034FILE \n' > "$tmp/base-lines"
  # Base text per changed test file: an added line that already existed at base is a move, not an escape.
  git diff --cached -M --no-color --name-status "$base" -- 'tests/*.sh' | while IFS=$'\t' read -r st p1 p2; do
    case $st in R*) bp=$p1; np=$p2;; A*) continue;; *) bp=$p1; np=$p1;; esac
    git cat-file -e "$base:$bp" 2>/dev/null || continue
    printf '\034FILE %s\n' "$np" >> "$tmp/base-lines"
    git show "$base:$bp" | awk '{ print "\034" $0 }' >> "$tmp/base-lines"
  done
  git diff --cached -M --no-color -U0 "$base" -- 'tests/*.sh' > "$tmp/escape.diff"
  awk -v re="$ESCAPE_RE" '
    # the escapes a line carries; several can share one line
    function kinds(s,  k) { k = ""
      if (s ~ /[|][|] *true/) k = k "t"
      if (s ~ /(^|[;&[:space:]])exit 0([^0-9]|$)/) k = k "x"
      if (s ~ /(^|[^A-Za-z_])(SKIP|skip)([_[:space:]:=]|$)/) k = k "s"
      return k }
    # an assertion name is prose, not code: match only what follows the name argument
    function body(s,  r) { r = s
      if (r !~ /^[ \t]*ok[ \t]/) return s
      sub(/^[ \t]*ok[ \t]+/, "", r)
      if (match(r, /^"[^"]*"[ \t]*/)) r = substr(r, RLENGTH + 1)
      else if (match(r, /^'"'"'[^'"'"']*'"'"'[ \t]*/)) r = substr(r, RLENGTH + 1)
      else if (match(r, /^[^ \t]+[ \t]*/)) r = substr(r, RLENGTH + 1)
      return r }
    # every escape on the added line was already on a removed line of the same hunk: the edit kept it, did not add it
    function covered(k, r,  i) { for (i = 1; i <= length(k); i++) if (index(r, substr(k, i, 1)) == 0) return 0
      return 1 }
    FNR == NR {
      if (substr($0, 1, 5) == "\034FILE") f = substr($0, 7)
      else base[f SUBSEP substr($0, 2)] = 1
      next }
    /^\+\+\+ (b\/|\/dev\/null)/ { f = substr($0, 7); removed = ""; next }
    /^@@/ { removed = ""; match($0, /\+[0-9]+/); ln = substr($0, RSTART + 1, RLENGTH - 1) + 0; next }
    /^-/ && !/^---/ { removed = removed kinds(body(substr($0, 2))); next }
    /^\+/ && !/^\+\+\+/ {
      line = substr($0, 2); n = ln++
      if (line ~ /^[ \t]*#/) next
      if (body(line) !~ re) next
      k = kinds(body(line))
      if ((f SUBSEP line) in base) next
      if (removed != "" && covered(k, removed)) next
      sub(/^[ \t]+/, "", line); print "test-escape " f ":" n " " line }' "$tmp/base-lines" "$tmp/escape.diff"
}

scan_weakened() {
  local bp np bc nc lost n other
  while IFS= read -r bp; do
    np=$bp
    # follow a rename so a moved file is compared with itself
    np=$(awk -F'\t' -v p="$bp" '$1 ~ /^R/ && $2 == p { print $3 }' "$tmp/changes" | head -1); np=${np:-$bp}
    bc=$(git show "$base:$bp" | grep -cE "$OK_RE")
    if git cat-file -e ":$np" 2>/dev/null; then nc=$(git show ":$np" | grep -cE "$OK_RE"); else nc=0; fi
    [ "$nc" -lt "$bc" ] || continue
    git show "$base:$bp" | grep -E "$OK_RE" | names | uniq > "$tmp/bn"
    if [ "$nc" -gt 0 ]; then git show ":$np" | grep -E "$OK_RE" | names | uniq > "$tmp/nn"; else : > "$tmp/nn"; fi
    lost=$(comm -23 "$tmp/bn" "$tmp/nn")
    # a lost name that lives on in another test file was moved, not dropped
    if [ -n "$lost" ]; then
      : > "$tmp/other"
      while IFS= read -r other; do [ "$other" = "$np" ] || git show ":$other" | grep -E "$OK_RE" | names >> "$tmp/other"; done < <(test_files tests)
      lost=$(printf '%s\n' "$lost" | grep -vxFf "$tmp/other")
      [ -n "$lost" ] || continue
    fi
    echo "weakened $np has $nc ok assertions, base had $bc"
  done < <(git ls-tree -r --name-only "$base" -- tests | grep -E '^tests/[^/]*\.test\.sh$')
}

{
scan_weakened
scan_escape
scan_gate
} | sort -u > "$tmp/findings"
cat "$tmp/findings"
[ ! -s "$tmp/findings" ]
