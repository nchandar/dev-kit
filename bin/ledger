#!/usr/bin/env bash
# Per-task, append-only TSV ledger. Never rewrites or deletes. One task = one ledger = one directory.
#   ledger start <slug> [note]                          create a task (ledger + state.md), keep .devkit out of git, print its id; refused inside a worker (exit 3)
#   ledger current                                      print this session's open task, else exit 1 (uses $CLAUDE_CODE_SESSION_ID)
#   ledger [-t id] <phase> <decision> <reason> [evidence] [result]   (phases path, done, base, start, current, verify-gate are reserved)
#   ledger [-t id] accept "<id> accepted" <reason>      for a --lead worker, refused (exit 5) when its branch is not built on the default branch tip; "<id> rejected" is always allowed
#   ledger [-t id] done [--waive "<reason>"] [summary]  mark the task finished; needs a passing verify-gate row for the current tree, or a waive reason of 20+ chars; refused inside a worker (exit 3)
#   ledger [-t id] path | ledger base                   print task dir | .devkit dir
#   ledger [-t id] gate-row <tier> <reason> <evidence> <result>   append the verify-gate row (bin/verify only, with the token it exports)
# Task: -t id, else $DEVKIT_TASK, else the session pointer. No task is an error: there is no shared fallback ledger.
# The pointer lives at $(ledger base)/run/session-<sid>.task; start rewrites it, only outside workers.
# $DEVKIT_DIR overrides the .devkit location. $DEVKIT_LEDGER_MIRROR="<cmd>" runs with the row text as $1.
set -u
here=$(cd "$(dirname "$0")" && pwd)
die() { echo "ledger: $*" >&2; exit 2; }
base() { local d
  if [ -n "${DEVKIT_DIR:-}" ]; then echo "$DEVKIT_DIR"; return; fi
  if d=$(git rev-parse --git-common-dir 2>/dev/null) && d=$(cd "$d" && pwd) && [ "$(basename "$d")" = .git ]; then echo "$(dirname "$d")/.devkit"
  else echo "$PWD/.devkit"; fi; }
clean() { printf '%s' "$1" | tr '\n\t' '  ' | cut -c1-400; }
exclude_local() { # keep .devkit out of git without touching any tracked file (common dir covers worktrees)
  local cd root ex rel
  cd=$(git rev-parse --git-common-dir 2>/dev/null) && cd=$(cd "$cd" && pwd) || return 0
  [ "$(basename "$cd")" = .git ] || return 0
  root=$(dirname "$cd"); case "$1" in "$root"/*) ;; *) return 0;; esac
  ex=$cd/info/exclude; rel="${1#$root/}/"; mkdir -p "$cd/info"
  grep -qxF "$rel" "$ex" 2>/dev/null || printf '%s\n' "$rel" >> "$ex"; }
STATE_TEMPLATE='# state\ngoal: (one line, or see spec.md)\n\n## Findings\n\n## Decisions\n\n## Direction\n\n## Open questions\n\n## Learnings\n'
HEADER='time\tphase\tdecision\treason\tevidence\tresult\n'
append() { # file phase decision reason evidence result
  local x; for x in "$2" "$3" "$4" "${5:-}" "${6:-}"; do [ "${#x}" -le 400 ] || { echo "ledger: a field was truncated to 400 chars; keep long evidence in a file and point to it" >&2; break; }; done
  ( set -C; printf "$HEADER" > "$1" ) 2>/dev/null || true
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -u +%FT%TZ)" "$(clean "$2")" "$(clean "$3")" "$(clean "$4")" "$(clean "${5:-}")" "$(clean "${6:-}")" >> "$1" || die "cannot write $1"
  # mirror runs detached and is killed after 10s so a hung supervisor never blocks a ledger call
  [ -z "${DEVKIT_LEDGER_MIRROR:-}" ] || ( sh -c "$DEVKIT_LEDGER_MIRROR" _ "$(clean "$2"): $(clean "$3") ${6:+[$(clean "$6")]}" >/dev/null 2>&1 &
    mp=$!; ( sleep 10; kill "$mp" 2>/dev/null ) >/dev/null 2>&1 & wait "$mp" ) >/dev/null 2>&1 & # sleep-ok: mirror kill timer
  return 0; }

B=$(base)
session_id() { # $CLAUDE_CODE_SESSION_ID when it is safe for a filename, else nothing
  local s=${CLAUDE_CODE_SESSION_ID:-}
  case $s in ''|*[!A-Za-z0-9_-]*) : ;; *) printf '%s' "$s";; esac; }
is_main() { # 0 for the main agent (depth 0 or unset, decimal), 1 for anything else
  local d=${DEVKIT_DEPTH:-0}
  case $d in ''|*[!0-9]*) return 1;; esac
  [ "$((10#$d))" -eq 0 ]; }
pointer_task() { # print the raw pointer id for this session, else fail
  local s p id=""
  s=$(session_id); [ -n "$s" ] || return 1
  p="$B/run/session-$s.task"; [ -f "$p" ] || return 1
  IFS= read -r id <"$p" || :
  printf '%s' "$id"; }
open_task() { # id: 0 when its dir exists and its last non-prune row is not done
  local id=$1 f="$B/tasks/$1" phase
  case $id in ''|.|..|*/*) return 1;; esac
  [ -d "$f" ] || return 1
  phase=$(awk -F'\t' 'NR>1 && $2!="prune"{p=$2} END{if(p!="")print p}' "$f/ledger.tsv" 2>/dev/null)
  [ -n "$phase" ] && [ "$phase" != done ]; }
current() { # print the session's open task, else nothing (exit 1); workers never use the pointer
  local id
  is_main || return 1
  id=$(pointer_task) || return 1
  open_task "$id" || return 1
  printf '%s\n' "$id"; }
write_pointer() { # id: atomically remember the task for this session; never fails start
  local s p
  s=$(session_id); [ -n "$s" ] || return 0
  p="$B/run/session-$s.task"
  { mkdir -p "$B/run" && printf '%s\n' "$1" > "$p.tmp.$$" && mv -f "$p.tmp.$$" "$p"; } 2>/dev/null \
    || rm -f "$p.tmp.$$" 2>/dev/null
  return 0; }
# close gate: 4 unless the tree equals the base (no diff) or this task's newest verify-gate row passed for it;
# a repo with no base ref closes with a note (scratch repos), writes nothing
gate() { local R t b trc brc row res rsn tier ev k evd runs
  R=$(git rev-parse --show-toplevel 2>/dev/null) || R=$(dirname "$B") # the caller's repo: a worktree is not the main checkout
  git -C "$R" rev-parse --show-toplevel >/dev/null 2>&1 || return 0 # outside a git repo there is nothing to verify
  # a missing or broken checker is a gate failure, never a pass
  [ -f "$here/verify" ] && [ -x "$here/verify" ] || { echo "ledger: bin/verify is missing or not executable; the verify gate cannot run" >&2; return 4; }
  t=$(cd "$R" && DEVKIT_TASK=$task "$here/verify" tree 2>/dev/null); trc=$?
  [ "$trc" -eq 0 ] && [ -n "$t" ] || { echo "ledger: bin/verify tree failed or printed nothing; the verify gate cannot run" >&2; return 4; }
  b=$(cd "$R" && DEVKIT_TASK=$task "$here/verify" base 2>/dev/null); brc=$?
  if [ "$brc" -eq 2 ]; then
    echo "ledger: no base ref or start commit to verify against (bin/verify base exit 2); the verify gate does not apply" >&2
    return 0; fi
  [ "$brc" -eq 0 ] && [ -n "$b" ] || { echo "ledger: bin/verify base failed (exit $brc); the verify gate cannot run" >&2; return 4; }
  k=$(cd "$R" && DEVKIT_TASK=$task "$here/verify" base-kind 2>/dev/null) || k=
  [ -z "$k" ] || [ "$k" = start ] || echo "ledger: the task's start commit is missing or gone; the base fell back to the merge-base" >&2 # a fallback narrows the proof: say it
  [ "$t" != "$b" ] || { echo "verified: nodiff tree $t log -${k:+ (base: $k)}"; return 0; } # nothing changed since the base: nothing to verify
  row=$(awk -F'\t' '$2=="verify-gate"{l=$0} END{print l}' "$D/ledger.tsv")
  [ -n "$row" ] || { echo "ledger: no verify-gate row for tree $t; run bin/verify, or use --waive \"<reason>\"" >&2; return 4; }
  res=$(printf '%s' "$row" | cut -f6); rsn=$(printf '%s' "$row" | cut -f4); tier=$(printf '%s' "$row" | cut -f3); ev=$(printf '%s' "$row" | cut -f5)
  [ "$res" = pass ] || { echo "ledger: the newest verify-gate row is $res for tree $t; run bin/verify, or use --waive \"<reason>\"" >&2; return 4; }
  case $rsn in *"tree $t"*) ;; *) echo "ledger: the verify pass is for another tree, not $t (the tree changed after it); run bin/verify again, or use --waive \"<reason>\"" >&2; return 4;; esac
  [ -n "$ev" ] && [ -f "$ev" ] || { echo "ledger: the verify-gate row has no log file at '${ev:-none}'; run bin/verify again, or use --waive \"<reason>\"" >&2; return 4; }
  evd=$(cd "$(dirname "$ev")" 2>/dev/null && pwd -P) || evd= # physical paths: /var and /private/var are the same dir
  runs=$(cd "$D/runs" 2>/dev/null && pwd -P) || runs=
  case $evd in "$runs"|"$runs"/*) [ -n "$runs" ] && [ -s "$ev" ];; *) false;; esac \
    || { echo "ledger: the verify-gate row needs a non-empty log under the task's runs/; run bin/verify again, or use --waive \"<reason>\"" >&2; return 4; }
  echo "verified: $tier $rsn log $ev"
  return 0; }

[ "${1:-}" = base ] && { echo "$B"; exit 0; }
if [ "${1:-}" = current ]; then
  if id=$(current); then printf '%s\n' "$id"; exit 0; fi
  exit 1
fi
if [ "${1:-}" = start ]; then
  depth=${DEVKIT_DEPTH:-0}
  case $depth in ''|*[!0-9]*) echo "ledger: a worker (DEVKIT_DEPTH=${DEVKIT_DEPTH:-unset}) must not start a task; log to its own DEVKIT_TASK" >&2; exit 3;; esac
  [ "$((10#$depth))" -eq 0 ] || { echo "ledger: a worker (DEVKIT_DEPTH=$depth) must not start a task; log to its own DEVKIT_TASK" >&2; exit 3; }
  slug=$(printf '%s' "${2:-task}" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' '-' | cut -c1-30)
  mkdir -p "$B/tasks" || die "cannot create tasks dir '$B/tasks'"
  tries=0
  until id="$slug-$(date +%y%m%d-%H%M%S)-$(printf '%04x' $RANDOM)"; mkdir "$B/tasks/$id" 2>/dev/null; do
    tries=$((tries+1)); [ "$tries" -ge 20 ] && die "cannot create task dir in '$B/tasks' after 20 tries" # pitfall-ok: decimal-arith internal counter, always decimal
  done
  headsha=$(git rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null) || headsha=
  append "$B/tasks/$id/ledger.tsv" start "${2:-task}${3:+: $3}" "new task" "${headsha:+head $headsha}" open
  printf "$STATE_TEMPLATE" > "$B/tasks/$id/state.md"; exclude_local "$B"
  write_pointer "$id"
  echo "$id"; exit 0
fi
task=${DEVKIT_TASK:-}
if [ "${1:-}" = path ] && [ "${2:-}" = -t ]; then task=${3:-}; set -- path
elif [ "${1:-}" = -t ]; then task=${2:-}; shift 2; fi
if [ -z "$task" ]; then task=$(current) || task=; fi
if [ -z "$task" ]; then
  if is_main && pid=$(pointer_task) && [ -n "$pid" ]; then
    case $pid in .|..|*/*) ;; *)
      die "your session's last task $pid is closed (or gone); run: ledger start <slug>, or pass -t <id>";; esac
  fi
  die "no task. Run: ledger start <slug>, then pass -t <id> or set DEVKIT_TASK, or just run ledger start"
fi
case $task in .|..|*/*) die "bad id '$task' (must not be . or .. or contain '/')";; esac
D=$B/tasks/$task; [ -d "$D" ] || die "unknown task '$task' (see bin/reconcile)"
case ${1:-} in
  path) echo "$D"; exit 0;;
  gate-row) # bin/verify's row write; the phase is reserved and the row must carry the per-run token it exports
    [ $# -eq 5 ] || die "usage: ledger gate-row <tier> <reason> <evidence> <result>"
    tf=${DEVKIT_GATE_TOKEN_FILE:-}; tok=${DEVKIT_GATE_TOKEN:-}
    [ -n "$tf" ] && [ -n "$tok" ] && [ -f "$tf" ] && [ -r "$tf" ] && [ "$(cat "$tf" 2>/dev/null)" = "$tok" ] \
      || { echo "ledger: gate-row is written only by bin/verify (its per-run token is missing or wrong); run bin/verify" >&2; exit 3; }
    append "$D/ledger.tsv" verify-gate "$2" "$3" "$4" "$5"; exit 0;;
  done)
    depth=${DEVKIT_DEPTH:-0}
    case $depth in ''|*[!0-9]*) echo "ledger: a worker (DEVKIT_DEPTH=${DEVKIT_DEPTH:-unset}) must not close the shared task; write its handoff instead" >&2; exit 3;; esac
    [ "$((10#$depth))" -eq 0 ] || { echo "ledger: a worker (DEVKIT_DEPTH=$depth) must not close the shared task; write its handoff instead" >&2; exit 3; }
    waive=; wreason=; summary=${2:-}
    if [ "${2:-}" = --waive ]; then
      wreason=${3:-}; summary=${4:-}
      [ "${#wreason}" -ge 20 ] || die "--waive needs a reason of 20+ characters (why the gate cannot run here); nothing written"
      waive=1
    fi
    if [ -z "$waive" ]; then gate; grc=$?; [ "$grc" -eq 0 ] || exit "$grc"; fi
    [ -z "$waive" ] || append "$D/ledger.tsv" waive "$wreason" "close allowed" "" waived
    append "$D/ledger.tsv" done "$summary" "task complete" "" done
    awk -F'\t' '$2=="waive"{print "waived: "$3}' "$D/ledger.tsv" # every waive stays visible at close
    n=0
    while IFS= read -r l; do case $l in "branch refs/heads/devkit/$task-"*) n=$((n+1));; esac; done < <(git worktree list --porcelain 2>/dev/null) # pitfall-ok: decimal-arith internal counter, always decimal
    [ "$n" -eq 0 ] || echo "ledger: $n worker worktree(s) left for this task; run: $(printf '%q' "$(cd "$(dirname "$0")" && pwd)/spawn") --prune -t $task --yes (add --discard if merged by squash)" >&2
    exit 0;;
esac
# a lead's work is merged as one unit, so accepting it on a stale base hides conflicts: its branch must contain the default branch's tip
lead_base_check() { local id=$1 br=devkit/$task-$1 def tip n d c
  [ -f "$D/run/$id.detached" ] || return 0 # only leads
  git rev-parse -q --verify "refs/heads/$br" >/dev/null 2>&1 || return 0 # no branch, nothing to judge
  def=$(git symbolic-ref -q refs/remotes/origin/HEAD 2>/dev/null) || def=
  { [ -n "$def" ] && git rev-parse -q --verify "$def" >/dev/null 2>&1; } || def=
  [ -n "$def" ] || for c in refs/heads/main refs/heads/master; do git rev-parse -q --verify "$c" >/dev/null 2>&1 && { def=$c; break; }; done
  [ -n "$def" ] || return 0
  tip=$(git rev-parse "$def"); git merge-base --is-ancestor "$tip" "refs/heads/$br" 2>/dev/null && return 0
  n=$(git rev-list --count "refs/heads/$br..$tip" 2>/dev/null) || n=?
  d=${def#refs/heads/}; d=${d#refs/remotes/}
  echo "ledger: lead $id is not built on the current $d: $br is $n commit(s) behind it. Rebase it (git -C $D/wt/$id rebase $d), rerun the checks, then accept again. A rejection is always allowed." >&2
  return 1; }
if [ "${1:-}" = accept ]; then
  read -r aid averdict _ <<< "${2:-}"
  if [ "${averdict:-}" = accepted ]; then lead_base_check "$aid" || exit 5; fi
fi
[ $# -ge 3 ] || die "usage: ledger [-t id] phase decision reason [evidence] [result] (phases path, done, base, start, current, verify-gate are reserved)"
[ "${1:-}" = verify-gate ] && die "phase 'verify-gate' is reserved: bin/verify writes it through ledger gate-row"
append "$D/ledger.tsv" "$@"
exit 0
