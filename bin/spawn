#!/usr/bin/env bash
# Run one sub-agent to completion on any CLI. Brief in, handoff out. Blocks; caller may background with &.
# Usage: bin/spawn [--shape ship|scout] [--worktree] [--model M] <id> <claude|codex|opencode> <brief-file>
#        bin/spawn [opts] --prompt "text" <id> <cli>        inline brief, saved to <task>/briefs/<id>.md
#        bin/spawn --doctor                                  which CLIs are installed and still accept our flags
# Needs DEVKIT_TASK (from `ledger start`). Per-task files live in .devkit/tasks/<task>/; worker slots are repo-wide.
# Herdr view (default when herdr is up): DEVKIT_VIEW=off disables, DEVKIT_VIEW_KEEP=1 keeps tabs (also failed ones), DEVKIT_VIEW_NOTIFY=all notifies on success,
#   spawn --close-views closes kept tabs. Failures print the id, state and last log lines to stderr.
# Workers skip permissions (DEVKIT_SAFE=1 for restricted modes) but can never push. Env knobs (defaults in bin/defaults, table in ARCHITECTURE.md): DEVKIT_MAX_WORKERS (repo-wide), DEVKIT_MAX_DEPTH (nesting), DEVKIT_CHILD_WAIT (nested spawns only), DEVKIT_TIMEOUT (zero turns it off), plus DEVKIT_MODEL, DEVKIT_DRYRUN (print the command only), DEVKIT_DIR
set -u
here=$(dirname "$0")
. "$here/defaults" || { echo "spawn: cannot load $here/defaults" >&2; exit 2; }

# flags each adapter relies on, checked against the CLI's own --help (catches version drift on a new machine)
doctor() { local bad=0 cli v h f need
  for cli in claude codex opencode; do
    if ! command -v $cli >/dev/null 2>&1; then printf '%-9s not installed\n' $cli; continue; fi
    v=$($cli --version 2>/dev/null | head -1 | tr -d '\r')
    case $cli in
      claude)   h=$(claude --help 2>&1);        need="-p --permission-mode --allowedTools --add-dir --no-session-persistence --model --dangerously-skip-permissions";;
      codex)    h=$(codex exec --help 2>&1);    need="-C -s --add-dir --skip-git-repo-check --ephemeral -o -m --dangerously-bypass-approvals-and-sandbox";;
      opencode) h=$(opencode run --help 2>&1);  need="--auto -m";;
    esac
    miss=""; for f in $need; do printf '%s\n' "$h" | grep -qE -- "(^|[[:space:],])$f([[:space:],=]|\$)" || miss="$miss $f"; done
    if [ -n "$miss" ]; then printf '%-9s %-22s MISSING%s\n' $cli "$v" "$miss"; bad=1; else printf '%-9s %-22s ok\n' $cli "$v"; fi
    if [ $cli = opencode ]; then opencode service status 2>&1 | grep -q '^http' || echo "          WARN opencode v2 needs its background service: run 'opencode service start' once in a normal terminal"; fi
  done; return $bad; }
[ "${1:-}" = --doctor ] && { doctor; exit $?; }
if [ "${1:-}" = --close-views ]; then # close herdr tabs kept open by DEVKIT_VIEW_KEEP=1
  [ -n "${DEVKIT_TASK:-}" ] || { echo "spawn: no task. Set DEVKIT_TASK" >&2; exit 2; }
  for f in "$("$here/ledger" -t "$DEVKIT_TASK" path)"/run/*.tab; do [ -f "$f" ] || continue; herdr tab close "$(cat "$f")" >/dev/null 2>&1; rm -f "$f"; done; exit 0
fi

shape=ship; wt=0; model=${DEVKIT_MODEL:-}; inline=
while [ $# -gt 0 ]; do case $1 in
  --shape) shape=$2; shift 2;; --worktree) wt=1; shift;; --model) model=$2; shift 2;; --prompt) inline=$2; shift 2;; *) break;; esac; done
want=3; [ -n "$inline" ] && want=2
[ $# -eq $want ] || { echo "usage: spawn [--shape ship|scout] [--worktree] [--model M] <id> <cli> <brief-file|--prompt text>" >&2; exit 2; }
id=$1 cli=$2 brief=${3:-}
depth=${DEVKIT_DEPTH:-0}; MAXD=$DEVKIT_MAX_DEPTH
case $depth$MAXD in *[!0-9]*|"") echo "spawn: DEVKIT_DEPTH and DEVKIT_MAX_DEPTH must be numbers" >&2; exit 2;; esac
depth=$((10#$depth)); MAXD=$((10#$MAXD)) # force decimal: 08/09 are not octal
[ "$depth" -lt "$MAXD" ] || { echo "spawn: depth $depth is at the limit $MAXD (DEVKIT_MAX_DEPTH); a worker at the limit must not spawn" >&2; exit 3; }
case $cli in claude|codex|opencode|fake) ;; *) echo "spawn: unknown cli '$cli'" >&2; exit 2;; esac
[ -n "$inline" ] || [ -r "$brief" ] || { echo "spawn: cannot read brief $brief" >&2; exit 2; }
case $id in *[!A-Za-z0-9_-]*|"") echo "spawn: bad id" >&2; exit 2;; esac

root=$PWD; CAP=$DEVKIT_MAX_WORKERS; TMO=$DEVKIT_TIMEOUT
case $CAP in ''|*[!0-9]*) echo "spawn: DEVKIT_MAX_WORKERS must be a whole number" >&2; exit 2;; esac
[ "$CAP" -ge 1 ] || { echo "spawn: DEVKIT_MAX_WORKERS must be at least 1" >&2; exit 2; }
case $DEVKIT_CHILD_WAIT in ''|*[!0-9]*) echo "spawn: DEVKIT_CHILD_WAIT must be a whole number" >&2; exit 2;; esac
case $TMO in ''|*[!0-9]*) echo "spawn: DEVKIT_TIMEOUT must be a whole number" >&2; exit 2;; esac
task=${DEVKIT_TASK:-}; [ -n "$task" ] || { echo "spawn: no task. Run: ledger start <slug>; set DEVKIT_TASK" >&2; exit 2; }
H=$("$here/ledger" base); mkdir -p "$H/run"; H=$(cd "$H" && pwd)
T=$H/tasks/$task; [ -d "$T" ] || { echo "spawn: unknown task '$task'" >&2; exit 2; }
hf=$T/handoffs/$id.md; log=$T/handoffs/$id.log; st=$T/run/$id.status

# the exact command per CLI, as an array so it can be dry-run tested; stdin is closed at launch (codex waits on it)
build_cmd() { # $1=workdir $2=prompt
  case $cli in
    claude)   perm=(--dangerously-skip-permissions)
              [ -z "${DEVKIT_SAFE:-}" ] || perm=(--permission-mode acceptEdits --allowedTools Bash Read Edit Write Grep Glob --add-dir "$T")
              cmd=(claude -p "$2" "${perm[@]}" --no-session-persistence)
              [ -z "$model" ] || cmd+=(--model "$model");;
    codex)    perm=(--dangerously-bypass-approvals-and-sandbox)
              [ -z "${DEVKIT_SAFE:-}" ] || perm=(-s workspace-write --add-dir "$T")
              cmd=(codex exec -C "$1" "${perm[@]}" --skip-git-repo-check --ephemeral -o "$T/handoffs/$id.last")
              [ -z "$model" ] || cmd+=(-m "$model"); cmd+=("$2");;
    opencode) cmd=(opencode run --auto)
              [ -z "$model" ] || cmd+=(-m "$model"); cmd+=("$2");;
    fake)     cmd=("$DEVKIT_FAKE" "$2" "$hf");;
  esac; }
make_prompt() { local spawnrule="Do not spawn agents"
  [ $((depth+1)) -ge "$MAXD" ] || spawnrule="You may spawn sub-workers with bin/spawn (you are at depth $((depth+1)) of $MAXD; they share the repo-wide worker cap and your DEVKIT_TASK), keeping fan-out small; if spawn exits 4 there is no free slot, so do that work yourself"
  echo "You are dev-kit sub-agent '$id' (shape: $shape). Read AGENTS.md. Your task is '$task' (DEVKIT_TASK is set): log with bin/ledger only. Do not start a new task or contact other workers. $spawnrule. Never git push, open PRs, or publish anything; only the main agent asks the user. Change only what the brief needs$( [ $shape = scout ] && echo '; this is a scout: change NO code, report only'). When finished, write your handoff (result PASS|ISSUES|BLOCKED, evidence, files changed, open questions, next step, learnings: any reusable lesson, each with a pointer) to this absolute path: $hf

--- BRIEF ---
$1"; }
brieftext() { if [ -n "$inline" ]; then printf '%s' "$inline"; else cat "$brief"; fi; }

if [ -n "${DEVKIT_DRYRUN:-}" ]; then build_cmd "$root" "$(make_prompt "$(brieftext)")"; printf '%s\n' "${cmd[@]}"; exit 0; fi

mkdir -p "$T/handoffs" "$T/run" "$T/briefs"
[ -z "$inline" ] || printf '%s\n' "$inline" > "$T/briefs/$id.md"

# concurrency: N slot dirs claimed with atomic mkdir; stale slots (dead/reused pid, no pid after 1s) are reclaimed under a per-slot lock
slot=
slot_live() { # $1=slot dir $2=pid: a slot is live only if the pid answers and its start time still matches
  kill -0 "$2" 2>/dev/null || return 1
  [ -s "$1/start" ] || return 0
  [ "$(LC_ALL=C TZ=UTC ps -o lstart= -p "$2" 2>/dev/null)" = "$(cat "$1/start" 2>/dev/null)" ]
}
claim() { local n d p p2 lock m live s pp
  n=1; while [ "$n" -le "$CAP" ]; do d=$H/run/slot.$n; lock=$d.lock
    if mkdir "$d" 2>/dev/null; then
      # CAP may have been lowered while higher slots live; a fresh dir must not push the live count over it
      live=0; for s in "$H"/run/slot.*; do case $s in "$d"|*.lock) continue;; esac
        [ -d "$s" ] || continue; pp=$(cat "$s/pid" 2>/dev/null); [ -n "$pp" ] || continue
        slot_live "$s" "$pp" && live=$((live+1)); done
      if [ "$live" -ge "$CAP" ]; then rm -rf "$d"
      else LC_ALL=C TZ=UTC ps -o lstart= -p $$ > "$d/start" 2>/dev/null; echo $$ > "$d/pid"; slot=$d; return 0; fi
    elif mkdir "$lock" 2>/dev/null; then
      p=$(cat "$d/pid" 2>/dev/null)
      if [ -z "$p" ]; then sleep 1; p=$(cat "$d/pid" 2>/dev/null); fi
      if [ -z "$p" ] || ! slot_live "$d" "$p"; then p2=$(cat "$d/pid" 2>/dev/null); [ "$p2" = "$p" ] && rm -rf "$d"; fi
      rm -rf "$lock"
    else
      m=$(stat -c %Y "$lock" 2>/dev/null || stat -f %m "$lock" 2>/dev/null)
      if [ -n "$m" ] && [ $(( $(date +%s) - m )) -gt 5 ]; then rm -rf "$lock"; fi
    fi
    n=$((n+1))
  done; return 1; }
# any exit, signals included, must not leave an orphan worker, an open tab or a held slot
wpid=""; guard=""; view=0; vtab=""; vdone=0
cleanup() { local rc=$?
  trap - EXIT
  if [ -n "$wpid" ] && kill -0 "$wpid" 2>/dev/null; then # interrupted while the worker ran
    [ -z "$guard" ] || { pkill -P "$guard" 2>/dev/null; kill "$guard" 2>/dev/null; }
    pkill -TERM -P "$wpid" 2>/dev/null; kill -TERM "$wpid" 2>/dev/null; sleep 1
    pkill -KILL -P "$wpid" 2>/dev/null; kill -KILL "$wpid" 2>/dev/null
    echo "killed $rc $(date +%s)" > "$st"
    "$here/ledger" -t "$task" spawn "$id killed" "interrupted (exit $rc)" "$hf" killed 2>/dev/null || true
  fi
  if [ "$view" = 1 ] && [ "$vdone" != 1 ]; then # the tab is closed or recorded on every path
    if [ -n "${DEVKIT_VIEW_KEEP:-}" ]; then echo "$vtab" > "$T/run/$id.tab"; else herdr tab close "$vtab" >/dev/null 2>&1; fi
  fi
  [ -z "$slot" ] || rm -rf "$slot"
  exit $rc; }
trap cleanup EXIT; trap 'exit 143' TERM; trap 'exit 130' INT; trap 'exit 129' HUP
waited=0
until claim; do # a nested spawn must not wait on slots its own parents hold, or the tree deadlocks
  if [ "$depth" -gt 0 ] && [ "$waited" -ge "$DEVKIT_CHILD_WAIT" ]; then echo "spawn: no free worker slot after ${DEVKIT_CHILD_WAIT}s; a nested spawn does not wait longer" >&2; exit 4; fi
  sleep 1; waited=$((waited+1))
done

wd=$root
if [ $wt = 1 ]; then
  wd=$T/wt/$id; mkdir -p "$T/wt"; br="devkit/$task-$id"
  if [ -e "$wd" ] && git worktree list --porcelain 2>/dev/null | grep -q "^worktree $wd$"; then : # repeated id: reuse its worktree
  else
    git worktree remove --force "$wd" 2>/dev/null || rm -rf "$wd"
    git worktree add -q "$wd" -b "$br" 2>/dev/null || git worktree add -q "$wd" "$br" || { echo "spawn: worktree failed" >&2; exit 1; }
  fi
fi
rm -f "$hf" "$T/run/$id.timedout"; echo "running $$ $(date +%s)" > "$st"
before=$(git -C "$wd" status --porcelain 2>/dev/null | grep -v ' \.devkit/')

build_cmd "$wd" "$(make_prompt "$(brieftext)")"
export DEVKIT_DEPTH=$((depth+1)) DEVKIT_DIR=$H DEVKIT_TASK=$task
# workers run with permissions skipped, so pushing is blocked here for every CLI: dead push URL on each existing remote.
# NOTE: only remote.<name>.pushurl is rewritten, so `git push <url>` with an explicit URL bypasses this; it is a guardrail, not a sandbox.
gn=${GIT_CONFIG_COUNT:-0}
for r in $(git -C "$wd" remote 2>/dev/null); do export "GIT_CONFIG_KEY_$gn=remote.$r.pushurl" "GIT_CONFIG_VALUE_$gn=/dev/null/push-blocked-by-dev-kit"; gn=$((gn+1)); done
[ "$gn" -eq 0 ] || export GIT_CONFIG_COUNT=$gn
# herdr view: a tab tails the worker log and the pane is reported as an agent. Execution below is unchanged.
view=0; vtab=""; vpane=""
case "$DEVKIT_VIEW" in off|0|false|no) ;; *) herdr tab list >/dev/null 2>&1 && view=1;; esac
vreport() { herdr pane report-agent --source dev-kit --agent "$cli" --state "$1" --message "$id: $2" "$vpane" >/dev/null 2>&1; }
if [ $view = 1 ]; then
  : > "$log"
  vj=$(herdr tab create --label "$id · $cli · $shape" --cwd "$wd" --no-focus 2>/dev/null)
  vtab=$(printf '%s' "$vj" | grep -o '"tab_id":"[^"]*"' | head -1 | cut -d'"' -f4)
  vpane=$(printf '%s' "$vj" | grep -o '"pane_id":"[^"]*"' | head -1 | cut -d'"' -f4)
  if [ -n "$vpane" ]; then
    herdr pane run "$vpane" "tail -n +1 -f '$log'" >/dev/null 2>&1
    herdr pane report-metadata --source dev-kit --agent "$cli" --title "$id: $(brieftext | head -1 | cut -c1-50)" --display-agent "$cli $shape" "$vpane" >/dev/null 2>&1
    vreport working running
  else view=0; fi
fi
( cd "$wd" && exec "${cmd[@]}" </dev/null ) > "$log" 2>&1 &
wpid=$!
guard=
if [ "$TMO" -gt 0 ] 2>/dev/null; then
  ( sleep "$TMO"; kill -0 "$wpid" 2>/dev/null || exit 0; : > "$T/run/$id.timedout"; pkill -TERM -P "$wpid" 2>/dev/null; kill -TERM "$wpid" 2>/dev/null; sleep 5; pkill -KILL -P "$wpid" 2>/dev/null; kill -KILL "$wpid" 2>/dev/null ) >/dev/null 2>&1 &
  guard=$!
fi
wait "$wpid"; rc=$?; wpid=""
if [ -n "$guard" ]; then pkill -P "$guard" 2>/dev/null; kill "$guard" 2>/dev/null; wait "$guard" 2>/dev/null; fi

state=done; [ $rc -eq 0 ] || state=failed
[ -f "$T/run/$id.timedout" ] && state=timeout
if [ ! -s "$hf" ]; then
  [ $state = done ] && state=failed
  { echo "# $id (auto-generated)"
    if [ $state = timeout ]; then echo "status: timed out after ${TMO}s (no handoff written). Last output:"; else echo "status: no handoff written (exit $rc). Last output:"; fi
    tail -n 20 "$log"; } > "$hf"
fi
after=$(git -C "$wd" status --porcelain 2>/dev/null | grep -v ' \.devkit/')
if [ $shape = scout ] && [ "$before" != "$after" ] && [ $state = done ]; then state=violation; fi
echo "$state $rc $(date +%s)" > "$st"
[ $state = done ] || { echo "spawn: $id $state (exit $rc); handoff $hf" >&2; tail -n 5 "$log" >&2; }
if [ $view = 1 ]; then
  if [ $state = done ]; then
    vreport idle done
    [ "${DEVKIT_VIEW_NOTIFY:-}" != all ] || herdr notification show "$id done" --body "$cli $shape: $hf" --sound done >/dev/null 2>&1
  else
    vreport blocked "$state"
    herdr notification show "$id $state" --body "$cli $shape: $hf" --sound request >/dev/null 2>&1
  fi
  # a headless worker's tab is not interactive; the error goes to the caller and the handoff, so close it on failure too
  if [ -n "${DEVKIT_VIEW_KEEP:-}" ]; then echo "$vtab" > "$T/run/$id.tab"
  else sleep "$DEVKIT_VIEW_CLOSE_DELAY"; herdr tab close "$vtab" >/dev/null 2>&1; fi
  vdone=1
fi
"$here/ledger" -t "$task" spawn "$id $state" "cli=$cli shape=$shape" "$hf" "$state" 2>/dev/null || true
[ $state = done ]
