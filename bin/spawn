#!/usr/bin/env bash
# Run one sub-agent to completion on any CLI. Brief in, handoff out. Blocks; caller may background with &.
# Usage: bin/spawn [--shape ship|scout] [--worktree] [--model M] <id> <claude|codex|opencode> <brief-file>
#        bin/spawn [opts] --prompt "text" <id> <cli>        inline brief, saved to <task>/briefs/<id>.md
#        bin/spawn --doctor                                  which CLIs are installed and still accept our flags
# Needs DEVKIT_TASK (from `ledger start`). Per-task files live in .devkit/tasks/<task>/; worker slots are repo-wide.
# Herdr view (default when herdr is up): DEVKIT_VIEW=off disables, DEVKIT_VIEW_KEEP=1 keeps tabs (also failed ones; otherwise every failed, timed-out or killed worker closes its tab after notifying), DEVKIT_VIEW_NOTIFY=all notifies on success,
#   spawn --close-views closes kept tabs. Failures print the id, state and last log lines to stderr.
#   The opencode adapter names its session (ses_dk_*), so its tab attaches to that live session with
#   `opencode -s <id>` instead of tailing the log; other CLIs, or an attach that never finds the session, tail the log.
# Interactive (DEVKIT_MODE=auto|interactive|headless): with herdr up, claude runs as its normal TUI in a herdr tab (visible todo panel), started with `herdr agent start`.
#   The brief goes in <task>/briefs/<id>.prompt and the agent gets one line pointing at it; the handoff file is the only DONE signal. Headless stays the fallback.
# Workers skip permissions (DEVKIT_SAFE=1 for restricted modes) but can never push. Env knobs (defaults in bin/defaults, table in ARCHITECTURE.md): DEVKIT_MAX_WORKERS (repo-wide), DEVKIT_MAX_DEPTH (nesting), DEVKIT_CHILD_WAIT (nested spawns only), DEVKIT_TIMEOUT (zero turns it off), plus DEVKIT_MODEL, DEVKIT_DRYRUN (print the command only), DEVKIT_DIR
set -u
here=$(dirname "$0")
. "$here/defaults" || { echo "spawn: cannot load $here/defaults" >&2; exit 2; }

# flags each adapter relies on, checked against the CLI's own --help (catches version drift on a new machine)
doctor() { local bad=0 cli v h f need
  for cli in claude codex opencode; do
    if ! command -v $cli >/dev/null 2>&1; then printf '%-9s not installed\n' $cli; continue; fi
    v=$($cli --version 2>/dev/null | head -1 | tr -d '\r')
    case $cli in
      claude)   h=$(claude --help 2>&1);        need="-p --permission-mode --allowedTools --add-dir --no-session-persistence --model --dangerously-skip-permissions";;
      codex)    h=$(codex exec --help 2>&1);    need="-C -s --add-dir --skip-git-repo-check --ephemeral -o -m --dangerously-bypass-approvals-and-sandbox";;
      opencode) h=$(opencode run --help 2>&1);  need="--auto -m -s --title";;
    esac
    miss=""; for f in $need; do printf '%s\n' "$h" | grep -qE -- "(^|[[:space:],])$f([[:space:],=]|\$)" || miss="$miss $f"; done
    if [ -n "$miss" ]; then printf '%-9s %-22s MISSING%s\n' $cli "$v" "$miss"; bad=1; else printf '%-9s %-22s ok\n' $cli "$v"; fi
    if [ $cli = opencode ]; then
      oc_cfg="$HOME/.config/opencode/opencode.jsonc"; [ -e "$oc_cfg" ] || oc_cfg="$HOME/.config/opencode/opencode.json"
      grep -Eq '"todo"[[:space:]]*:[[:space:]]*true' "$oc_cfg" 2>/dev/null || echo "          WARN opencode todo panel is off: set experimental.todo to true in $oc_cfg (or run install.sh), then 'opencode service restart'"
    fi
    if [ $cli = opencode ]; then opencode service status 2>&1 | grep -q '^http' || echo "          WARN opencode v2 needs its background service: run 'opencode service start' once in a normal terminal"; fi
  done; return $bad; }
[ "${1:-}" = --doctor ] && { doctor; exit $?; }
if [ "${1:-}" = --close-views ]; then # close herdr tabs kept open by DEVKIT_VIEW_KEEP=1
  [ -n "${DEVKIT_TASK:-}" ] || { echo "spawn: no task. Set DEVKIT_TASK" >&2; exit 2; }
  for f in "$("$here/ledger" -t "$DEVKIT_TASK" path)"/run/*.tab; do [ -f "$f" ] || continue; herdr tab close "$(cat "$f")" >/dev/null 2>&1; rm -f "$f"; done; exit 0
fi

shape=ship; wt=0; model=${DEVKIT_MODEL:-}; inline=
while [ $# -gt 0 ]; do case $1 in
  --shape) shape=${2-}; shift 2;; --worktree) wt=1; shift;; --model) model=$2; shift 2;; --prompt) inline=$2; shift 2;; *) break;; esac; done
case $shape in ship|scout) ;; *) echo "spawn: --shape must be ship or scout" >&2; exit 2;; esac
want=3; [ -n "$inline" ] && want=2
[ $# -eq $want ] || { echo "usage: spawn [--shape ship|scout] [--worktree] [--model M] <id> <cli> <brief-file|--prompt text>" >&2; exit 2; }
id=$1 cli=$2 brief=${3:-}
depth=${DEVKIT_DEPTH:-0}; MAXD=$DEVKIT_MAX_DEPTH
case $depth$MAXD in *[!0-9]*|"") echo "spawn: DEVKIT_DEPTH and DEVKIT_MAX_DEPTH must be numbers" >&2; exit 2;; esac
depth=$((10#$depth)); MAXD=$((10#$MAXD)) # force decimal: 08/09 are not octal
[ "$depth" -lt "$MAXD" ] || { echo "spawn: depth $depth is at the limit $MAXD (DEVKIT_MAX_DEPTH); a worker at the limit must not spawn" >&2; exit 3; }
case $cli in claude|codex|opencode|fake) ;; *) echo "spawn: unknown cli '$cli'" >&2; exit 2;; esac
case $DEVKIT_MODE in auto|interactive|headless) ;; *) echo "spawn: DEVKIT_MODE must be auto, interactive or headless" >&2; exit 2;; esac
case $DEVKIT_NUDGE_WAIT in ''|*[!0-9]*) echo "spawn: DEVKIT_NUDGE_WAIT must be a whole number of seconds" >&2; exit 2;; esac
[ -n "$inline" ] || [ -r "$brief" ] || { echo "spawn: cannot read brief $brief" >&2; exit 2; }
case $id in *[!A-Za-z0-9_-]*|"") echo "spawn: bad id" >&2; exit 2;; esac

root=$(pwd -P); CAP=$DEVKIT_MAX_WORKERS; TMO=$DEVKIT_TIMEOUT
case $CAP in ''|*[!0-9]*) echo "spawn: DEVKIT_MAX_WORKERS must be a whole number" >&2; exit 2;; esac
[ "$CAP" -ge 1 ] || { echo "spawn: DEVKIT_MAX_WORKERS must be at least 1" >&2; exit 2; }
case $DEVKIT_CHILD_WAIT in ''|*[!0-9]*) echo "spawn: DEVKIT_CHILD_WAIT must be a whole number" >&2; exit 2;; esac
case $TMO in ''|*[!0-9]*) echo "spawn: DEVKIT_TIMEOUT must be a whole number" >&2; exit 2;; esac
case $DEVKIT_POLL$DEVKIT_GRACE in *[!0-9]*) echo "spawn: DEVKIT_POLL and DEVKIT_GRACE must be whole numbers" >&2; exit 2;; esac
case ${GIT_CONFIG_COUNT:-0} in ''|*[!0-9]*) echo "spawn: GIT_CONFIG_COUNT must be a whole number" >&2; exit 2;; esac
task=${DEVKIT_TASK:-}; [ -n "$task" ] || { echo "spawn: no task. Run: ledger start <slug>; set DEVKIT_TASK" >&2; exit 2; }
H=$("$here/ledger" base); mkdir -p "$H/run"; H=$(cd "$H" && pwd)
T=$H/tasks/$task; [ -d "$T" ] || { echo "spawn: unknown task '$task'" >&2; exit 2; }
hf=$T/handoffs/$id.md; log=$T/handoffs/$id.log; st=$T/run/$id.status
# opencode sessions must start with "ses"; a per-run suffix keeps re-spawns from inheriting an old session
sid="ses_dk_$(printf '%s-%s' "${task:-t}" "$id" | tr -c 'A-Za-z0-9' '_')_$(date +%s)"

# the exact command per CLI, as an array so it can be dry-run tested; stdin is closed at launch (codex waits on it)
build_cmd() { # $1=workdir $2=prompt
  case $cli in
    claude)   perm=(--dangerously-skip-permissions)
              [ -z "${DEVKIT_SAFE:-}" ] || perm=(--permission-mode acceptEdits --allowedTools Bash Read Edit Write Grep Glob --add-dir "$T")
              cmd=(claude -p "$2" "${perm[@]}" --no-session-persistence)
              [ -z "$model" ] || cmd+=(--model "$model");;
    codex)    perm=(--dangerously-bypass-approvals-and-sandbox)
              [ -z "${DEVKIT_SAFE:-}" ] || perm=(-s workspace-write --add-dir "$T")
              cmd=(codex exec -C "$1" "${perm[@]}" --skip-git-repo-check --ephemeral -o "$T/handoffs/$id.last")
              [ -z "$model" ] || cmd+=(-m "$model"); cmd+=("$2");;
    opencode) cmd=(opencode run --auto -s "$sid" --title "$id · $shape")
              [ -z "$model" ] || cmd+=(-m "$model"); cmd+=("$2");;
    fake)     cmd=("$DEVKIT_FAKE" "$2" "$hf");;
  esac; }
# the worker follows a route's playbook by path and loads its checklist itself: the brief's `route: dev-x` line, else the shape's default (ship: dev-feature, scout: dev-research)
worker_route() { local rt
  rt=$(printf '%s\n' "$1" | sed -n 's/^route: \(dev-[a-z]*\)[[:space:]]*$/\1/p' | head -1)
  [ "$rt" != dev-mode ] && [ -f "$here/../skills/$rt/SKILL.md" ] || { rt=dev-feature; [ $shape != scout ] || rt=dev-research; }
  echo "$rt"; }
make_prompt() { local spawnrule="Do not spawn agents"
  [ $((depth+1)) -ge "$MAXD" ] || spawnrule="You may spawn sub-workers with bin/spawn (you are at depth $((depth+1)) of $MAXD; they share the repo-wide worker cap and your DEVKIT_TASK), keeping fan-out small; if spawn exits 4 there is no free slot, so do that work yourself" # pitfall-ok: decimal-arith forced decimal on line 42
  echo "FIRST ACTION, before any other tool call: read $(cd "$here/.." && pwd)/skills/$(worker_route "$1")/SKILL.md by path and open its Checklist verbatim in your host todo list (TaskCreate, TodoWrite, update_plan or todowrite, whichever you have; if the tool is deferred, load it with ToolSearch first) so it shows in your side panel. Mark the current step in_progress, tick each item as you finish it; a skipped item stays listed with a reason. Only then start the work below.
You are dev-kit sub-agent '$id' (shape: $shape). Read AGENTS.md. Your task is '$task' (DEVKIT_TASK is set): log with bin/ledger only. Do not start a new task or contact other workers. $spawnrule. Never git push, open PRs, or publish anything; only the main agent asks the user. Change only what the brief needs$( [ $shape = scout ] && echo '; this is a scout: change NO code, report only'). When finished, write your handoff (result PASS|ISSUES|BLOCKED, evidence, files changed, open questions, next step, learnings: any reusable lesson, each with a pointer) to this absolute path: $hf

Route: $(worker_route "$1") (the checklist above). The brief's scope and non-goals override the playbook where they conflict. End your handoff with a '## Checklist' section copying every item as [x] done, [-] skipped (reason) or [ ] open.

--- BRIEF ---
$1"; }
brieftext() { if [ -n "$inline" ]; then printf '%s' "$inline"; else cat "$brief"; fi; }

# workers run with permissions skipped, so pushing is blocked here for every CLI: dead push URL on each existing remote.
# NOTE: only remote.<name>.pushurl is rewritten, so `git push <url>` with an explicit URL bypasses this; it is a guardrail, not a sandbox.
set_guard() { local gn r # $1=workdir
  export DEVKIT_DEPTH=$((depth+1)) DEVKIT_DIR=$H DEVKIT_TASK=$task # pitfall-ok: decimal-arith depth validated above
  gn=$((10#${GIT_CONFIG_COUNT:-0})) # 08 is decimal 8, not an octal error
  for r in $(git -C "$1" remote 2>/dev/null); do export "GIT_CONFIG_KEY_$gn=remote.$r.pushurl" "GIT_CONFIG_VALUE_$gn=/dev/null/push-blocked-by-dev-kit"; gn=$((gn+1)); done # pitfall-ok: decimal-arith gn forced through 10# above
  [ "$gn" -eq 0 ] || export GIT_CONFIG_COUNT=$gn; }
qesc() { local v=${1//\\/\\\\}; printf '%s' "${v//\"/\\\"}"; } # backslash and quote escaping for JSON and TOML strings
# the pane's shell belongs to herdr, so spawn's own exports never reach the worker: pass them through tab create --env
build_ienv() { local k i n; ienv=(--env "DEVKIT_TASK=$task" --env "DEVKIT_DEPTH=$DEVKIT_DEPTH" --env "DEVKIT_DIR=$H")
  for k in DEVKIT_MAX_WORKERS DEVKIT_MAX_DEPTH DEVKIT_CHILD_WAIT DEVKIT_TIMEOUT DEVKIT_MODE DEVKIT_SAFE DEVKIT_MODEL; do [ -z "${!k:-}" ] || ienv+=(--env "$k=${!k}"); done
  [ "$cli" != claude ] || ienv+=(--env "CLAUDE_CODE_ENABLE_TODO_TOOLS=1") # without it a worker claude has no TaskCreate/TodoWrite, so no checklist panel
  [ "$cli" != opencode ] || [ -z "$model" ] || ienv+=(--env "OPENCODE_CONFIG_CONTENT={\"model\":\"$(qesc "$model")\"}")
  n=$((10#${GIT_CONFIG_COUNT:-0})); [ "$n" -eq 0 ] || ienv+=(--env "GIT_CONFIG_COUNT=$n")
  i=0; while [ "$i" -lt "$n" ]; do k=GIT_CONFIG_KEY_$i; ienv+=(--env "$k=${!k}"); k=GIT_CONFIG_VALUE_$i; ienv+=(--env "$k=${!k}"); i=$((i+1)); done; } # pitfall-ok: decimal-arith n forced through 10# above
# interactive: the args after `agent start ... --`; herdr supplies the executable. No -p/exec/run, the TUI shows the todo panel
build_icmd() { # $1=workdir
  case $cli in
    claude) perm=(--dangerously-skip-permissions)
            [ -z "${DEVKIT_SAFE:-}" ] || perm=(--permission-mode acceptEdits --allowedTools Bash Read Edit Write Grep Glob --add-dir "$T")
            icmd=("${perm[@]}" -n "$id")
            [ -z "$model" ] || icmd+=(--model "$model");;
    codex)  perm=(--dangerously-bypass-approvals-and-sandbox)
            [ -z "${DEVKIT_SAFE:-}" ] || perm=(-s workspace-write --add-dir "$T")
            # an untrusted dir makes the TUI stop on "Trust this folder?"; the override answers it for the repo and a worktree
            icmd=(-C "$1" "${perm[@]}" -c "projects.\"$(qesc "$root")\".trust_level=\"trusted\"")
            [ "$1" = "$root" ] || icmd+=(-c "projects.\"$(qesc "$1")\".trust_level=\"trusted\"")
            [ -z "$model" ] || icmd+=(-m "$model");;
    # the TUI has no -m; the model rides in the tab env. experimental.todo (todo panel) lives in the global config, see doctor
    opencode) icmd=(--auto -s "$sid");;
  esac; }
ipanes() { # $1=workdir $2=pane id -> tabargs, startargs, promptargs
  tabargs=(tab create --label "$id · $cli · $shape" --cwd "$1" --no-focus "${ienv[@]}")
  startargs=(agent start "$id" --kind "$cli" --pane "$2" -- "${icmd[@]}")
  promptargs=(agent prompt "$id" "Read $T/briefs/$id.prompt and follow it. $todorule"); }
# the long prompt's first line is lost on some runs; the short line the agent cannot skip repeats it
todorule="FIRST ACTION, before any other tool call: open the checklist from that file in your host todo list (TaskCreate, TodoWrite, update_plan or todowrite)."
# glyphs and boxes a CLI draws for a task list; plain words would match our own echoed prompt
todoseen='☐|☒|◼|◻|▢|\[[ x~-]\] |Todos'
nudged=0

# herdr view or interactive mode needs a live herdr; an explicit interactive request must not silently run headless
view=0; imode=0; ilist=" claude codex opencode "
if [ -n "${DEVKIT_DRYRUN:-}" ] && [ "$DEVKIT_MODE" = interactive ]; then view=1
else case "$DEVKIT_VIEW" in off|0|false|no) ;; *) herdr tab list >/dev/null 2>&1 && view=1;; esac; fi
if [ "$DEVKIT_MODE" != headless ]; then
  case "$ilist" in *" $cli "*) [ $view = 0 ] || imode=1;; esac
  if [ $imode = 0 ] && [ "$DEVKIT_MODE" = interactive ]; then echo "spawn: DEVKIT_MODE=interactive needs a running herdr (DEVKIT_VIEW not off) and one of:$ilist" >&2; exit 2; fi
fi

if [ -n "${DEVKIT_DRYRUN:-}" ]; then
  if [ $imode = 1 ]; then set_guard "$root"; build_ienv; build_icmd "$root"; ipanes "$root" "<pane>"
    echo interactive; for a in tabargs startargs promptargs; do eval "printf '%s ' \"\${$a[@]}\""; echo; done; exit 0; fi
  build_cmd "$root" "$(make_prompt "$(brieftext)")"; printf '%s\n' "${cmd[@]}"; exit 0
fi

mkdir -p "$T/handoffs" "$T/run" "$T/briefs"
# two live spawns of one id would clobber its handoff, log and status
if [ -f "$st" ]; then read -r sst spid _ < "$st" 2>/dev/null || true; else sst= spid=; fi
if [ "${sst:-}" = running ] && [ -n "${spid:-}" ] && kill -0 "$spid" 2>/dev/null; then echo "spawn: $id is already running (pid $spid); pick another id" >&2; exit 2; fi
[ -z "$inline" ] || printf '%s\n' "$inline" > "$T/briefs/$id.md"

# concurrency: N slot dirs claimed with atomic mkdir; stale slots (dead/reused pid, no pid after 1s) are reclaimed under a per-slot lock
slot=
slot_live() { # $1=slot dir $2=pid: live if the spawner answers with a matching start time, or (kill -9 of spawn) its worker still runs
  local wp
  if kill -0 "$2" 2>/dev/null; then
    [ -s "$1/start" ] || return 0
    [ "$(LC_ALL=C TZ=UTC ps -o lstart= -p "$2" 2>/dev/null)" != "$(cat "$1/start" 2>/dev/null)" ] || return 0
  fi
  wp=$(cat "$1/wpid" 2>/dev/null); [ -n "$wp" ] && kill -0 "$wp" 2>/dev/null
}
claim() { local n d p p2 lock m live s pp
  n=1; while [ "$n" -le "$CAP" ]; do d=$H/run/slot.$n; lock=$d.lock
    if mkdir "$d" 2>/dev/null; then
      # pid first: until it exists a reclaimer may treat the dir as abandoned
      if ! echo $$ > "$d/pid" 2>/dev/null; then rm -rf "$d"; n=$((n+1)); continue; fi # pitfall-ok: decimal-arith internal counter
      # CAP may have been lowered while higher slots live; a fresh dir must not push the live count over it
      live=0; for s in "$H"/run/slot.*; do case $s in "$d"|*.lock) continue;; esac
        [ -d "$s" ] || continue; pp=$(cat "$s/pid" 2>/dev/null); [ -n "$pp" ] || continue
        slot_live "$s" "$pp" && live=$((live+1)); done # pitfall-ok: decimal-arith internal counter
      if [ "$live" -ge "$CAP" ]; then rm -rf "$d"
      else LC_ALL=C TZ=UTC ps -o lstart= -p $$ > "$d/start" 2>/dev/null
        # a reclaimer may still have removed the dir; only a verified pid means the slot is ours
        if [ "$(cat "$d/pid" 2>/dev/null)" = "$$" ]; then slot=$d; return 0; fi; fi
    elif mkdir "$lock" 2>/dev/null; then
      p=$(cat "$d/pid" 2>/dev/null)
      if [ -z "$p" ]; then sleep 1; p=$(cat "$d/pid" 2>/dev/null); fi
      if [ -z "$p" ] || ! slot_live "$d" "$p"; then p2=$(cat "$d/pid" 2>/dev/null); [ "$p2" = "$p" ] && rm -rf "$d"; fi
      rm -rf "$lock"
    else
      m=$(stat -c %Y "$lock" 2>/dev/null || stat -f %m "$lock" 2>/dev/null) # pitfall-ok: portable-cmd GNU-or-BSD fallback pair
      case $m in ''|*[!0-9]*) m=;; esac # the GNU fallback prints filesystem info, not an mtime; a vanished lock must not reach the arithmetic
      if [ -n "$m" ] && [ $(( $(date +%s) - m )) -gt 5 ]; then rm -rf "$lock"; fi # pitfall-ok: decimal-arith date is decimal, m guarded by -n
    fi
    n=$((n+1)) # pitfall-ok: decimal-arith internal counter
  done; return 1; }
# any exit, signals included, must not leave an orphan worker, an open tab or a held slot
wpid=""; guard=""; vtab=""; vpane=""; vdone=0; idone=0; istarted=0
cleanup() { local rc=$?
  trap - EXIT
  if [ -n "$wpid" ] && kill -0 "$wpid" 2>/dev/null; then # interrupted while the worker ran
    [ -z "$guard" ] || { pkill -P "$guard" 2>/dev/null; kill "$guard" 2>/dev/null; }
    kill -TERM -- "-$wpid" 2>/dev/null; kill -TERM "$wpid" 2>/dev/null; sleep 1
    kill -KILL -- "-$wpid" 2>/dev/null; kill -KILL "$wpid" 2>/dev/null
    echo "killed $rc $(date +%s)" > "$st"
    "$here/ledger" -t "$task" spawn "$id killed" "interrupted (exit $rc)" "$hf" killed 2>/dev/null || true
  fi
  if [ "$imode" = 1 ] && [ "$istarted" = 1 ] && [ "$idone" != 1 ]; then # before the tab exists an early exit keeps its real status
    echo "killed $rc $(date +%s)" > "$st"
    if [ -n "$vpane" ] && [ ! -s "$hf" ]; then { echo "# $id (auto-generated)"; echo "status: killed (exit $rc), no handoff written. Last output:"; herdr pane read --lines 20 "$vpane" 2>/dev/null; } > "$hf"; fi
    herdr notification show "$id killed" --body "$cli $shape: $hf" --sound request >/dev/null 2>&1
    "$here/ledger" -t "$task" spawn "$id killed" "interrupted (exit $rc)" "$hf" killed 2>/dev/null || true
  fi
  if [ "$view" = 1 ] && [ "$vdone" != 1 ] && [ -n "$vtab" ]; then # the tab is closed or recorded on every path
    if [ -n "${DEVKIT_VIEW_KEEP:-}" ]; then echo "$vtab" > "$T/run/$id.tab"; else herdr tab close "$vtab" >/dev/null 2>&1; fi
  fi
  [ -z "$slot" ] || rm -rf "$slot"
  exit $rc; }
trap cleanup EXIT; trap 'exit 143' TERM; trap 'exit 130' INT; trap 'exit 129' HUP
waited=0
until claim; do # a nested spawn must not wait on slots its own parents hold, or the tree deadlocks
  if [ "$depth" -gt 0 ] && [ "$waited" -ge "$DEVKIT_CHILD_WAIT" ]; then echo "spawn: no free worker slot after ${DEVKIT_CHILD_WAIT}s; a nested spawn does not wait longer" >&2; exit 4; fi
  sleep 1; waited=$((waited+1)) # pitfall-ok: decimal-arith internal counter
done

wd=$root
if [ $wt = 1 ]; then
  wd=$T/wt/$id; mkdir -p "$T/wt"; br="devkit/$task-$id"
  if [ -e "$wd" ] && git worktree list --porcelain 2>/dev/null | grep -q "^worktree $wd$"; then : # repeated id: reuse its worktree
  else
    git worktree remove --force "$wd" 2>/dev/null || rm -rf "$wd"
    git worktree add -q "$wd" -b "$br" 2>/dev/null || git worktree add -q "$wd" "$br" || { echo "spawn: worktree failed" >&2; exit 1; }
  fi
fi
rm -f "$hf" "$T/run/$id.timedout"; echo "running $$ $(date +%s)" > "$st"
# HEAD plus content hashes of tracked changes and untracked files, so commits and repeat edits show up too
snap() { { git -C "$wd" rev-parse HEAD 2>/dev/null; git -C "$wd" diff HEAD -- . ':(exclude).devkit' 2>/dev/null
  git -C "$wd" -c core.quotepath=off ls-files -o --exclude-standard 2>/dev/null | grep -v '^\.devkit/' | while IFS= read -r f; do printf '%s ' "$f"; git hash-object -- "$wd/$f"; done; } | git hash-object --stdin; }
before=$(snap)

set_guard "$wd"
if [ $imode = 1 ]; then build_ienv; build_icmd "$wd"; else build_cmd "$wd" "$(make_prompt "$(brieftext)")"; fi
# herdr view: a tab tails the worker log and the pane is reported as an agent. Execution below is unchanged.
vtab=""; vpane=""
vreport() { herdr pane report-agent --source dev-kit --agent "$cli" --state "$1" --message "$id: $2" "$vpane" >/dev/null 2>&1; }
if [ $imode = 1 ]; then # the worker is the TUI in this tab; nothing tails a log
  : > "$log"; istarted=1
  vj=$(herdr tab create --label "$id · $cli · $shape" --cwd "$wd" --no-focus "${ienv[@]}" 2>/dev/null)
  vtab=$(printf '%s' "$vj" | grep -o '"tab_id":"[^"]*"' | head -1 | cut -d'"' -f4)
  vpane=$(printf '%s' "$vj" | grep -o '"pane_id":"[^"]*"' | head -1 | cut -d'"' -f4)
  if [ -z "$vpane" ]; then echo "spawn: interactive tab create failed; $id not started (no silent headless fallback; DEVKIT_MODE=headless forces it)" >&2; icreate=failed; fi
elif [ $view = 1 ]; then
  : > "$log"
  vj=$(herdr tab create --label "$id · $cli · $shape" --cwd "$wd" --no-focus 2>/dev/null)
  vtab=$(printf '%s' "$vj" | grep -o '"tab_id":"[^"]*"' | head -1 | cut -d'"' -f4)
  vpane=$(printf '%s' "$vj" | grep -o '"pane_id":"[^"]*"' | head -1 | cut -d'"' -f4)
  if [ -n "$vpane" ]; then
    # the pane watches the spawn pid itself: a hard kill (kill -9) runs no EXIT trap,
    # so the pane closes its own tab once the spawner is gone (unless the tab is kept)
    # opencode names its session, so its tab attaches to the live agent; any other CLI tails the log
    vattach=""
    if [ "$cli" = opencode ]; then
      vattach="for i in \$(seq 1 60); do opencode session list 2>/dev/null | grep -q '^$sid' && exec opencode -s '$sid'; sleep 0.5; done; exec tail -n +1 -f '$log'"
    fi
    if [ -n "$vattach" ]; then
      if [ -n "${DEVKIT_VIEW_KEEP:-}" ]; then vwatch="$vattach"
      else vwatch="( while kill -0 $$ 2>/dev/null; do sleep 1; done; herdr tab close '$vtab' >/dev/null 2>&1 ) >/dev/null 2>&1 & $vattach"; fi
    elif [ -n "${DEVKIT_VIEW_KEEP:-}" ]; then vwatch="tail -n +1 -f '$log'"
    else vwatch="tail -n +1 -f '$log' & tp=\$!; while kill -0 $$ 2>/dev/null; do sleep 1; done; kill \$tp 2>/dev/null; herdr tab close '$vtab' >/dev/null 2>&1"; fi
    herdr pane run "$vpane" "$vwatch" >/dev/null 2>&1
    herdr pane report-metadata --source dev-kit --agent "$cli" --title "$id: $(brieftext | head -1 | cut -c1-50)" --display-agent "$cli $shape" "$vpane" >/dev/null 2>&1
    vreport working running
  else view=0; fi
fi
if [ $imode = 1 ]; then
  # start the TUI, hand it one line pointing at the full prompt file; the handoff file is the only DONE signal
  make_prompt "$(brieftext)" > "$T/briefs/$id.prompt"
  ipanes "$wd" "$vpane"; istate=; ireason=; rc=0
  if [ "${icreate:-}" = failed ]; then istate=failed; ireason="tab create failed: herdr answered but gave no pane"
  elif ! herdr "${startargs[@]}" >/dev/null 2>&1; then istate=failed; ireason="agent start failed: $cli not ready (trust dialog, login or update prompt?)"
  elif ! herdr "${promptargs[@]}" >/dev/null 2>&1; then istate=failed; ireason="agent prompt rejected (agent blocked or gone)"; fi
  # an errored agent get is "still working" unless the pane is gone: a flaky call must not end the run on a partial handoff
  idle_agent() { local o; if o=$(herdr agent get "$id" 2>/dev/null); then ! printf '%s' "$o" | grep -q '"agent_status": *"working"'; else ! herdr pane get "$vpane" >/dev/null 2>&1; fi; }
  t0=$(date +%s); gone=0; agone=0
  while [ -z "$istate" ]; do
    # done = a handoff that ends with its ## Checklist, or any handoff once the agent stops working; an early partial handoff keeps the run open
    if [ -s "$hf" ] && { grep -q '^## Checklist' "$hf" || idle_agent; }; then sleep "$DEVKIT_GRACE"; istate=done; break; fi # grace: the worker may still be writing
    if [ "$TMO" -gt 0 ] && [ $(( $(date +%s) - t0 )) -ge "$TMO" ]; then : > "$T/run/$id.timedout"; istate=timeout; ireason="timed out after ${TMO}s"; break; fi # pitfall-ok: decimal-arith epoch seconds are decimal
    if [ "$nudged" = 0 ] && [ "$DEVKIT_NUDGE_WAIT" -gt 0 ] && [ $(( $(date +%s) - t0 )) -ge "$DEVKIT_NUDGE_WAIT" ]; then # pitfall-ok: decimal-arith epoch seconds are decimal
      nudged=1 # once only: a second nudge would read as noise to a busy agent
      if ! herdr pane read --lines 60 "$vpane" 2>/dev/null | grep -qE "$todoseen"; then
        herdr agent prompt "$id" "No task list is visible. Open your host todo list now (TaskCreate, TodoWrite, update_plan or todowrite) with the checklist from $T/briefs/$id.prompt, then continue." >/dev/null 2>&1
        "$here/ledger" -t "$task" spawn "$id nudge" "no task list on screen after ${DEVKIT_NUDGE_WAIT}s; re-sent the checklist instruction" "$T/briefs/$id.prompt" nudged 2>/dev/null || true
      fi
    fi
    if herdr pane get "$vpane" >/dev/null 2>&1; then gone=0
    else gone=$((gone+1)); if [ "$gone" -ge 3 ]; then istate=failed; ireason="pane gone (the tab or CLI exited without a handoff)"; [ ! -s "$hf" ] || istate=done; break; fi; fi # pitfall-ok: decimal-arith internal counter
    # an agent that is unknown while its pane stays open will never write a handoff: fail early, not at the timeout
    if [ ! -s "$hf" ]; then
      if herdr agent get "$id" >/dev/null 2>&1; then agone=0
      else agone=$((agone+1)); if [ "$agone" -ge 3 ]; then istate=failed; ireason="agent gone (unknown to herdr, pane still open, no handoff)"; break; fi; fi # pitfall-ok: decimal-arith internal counter
    fi
    sleep "$DEVKIT_POLL"
  done
  [ "$istate" = done ] || [ -s "$hf" ] || { echo "$ireason"; herdr pane read --lines 20 "$vpane" 2>/dev/null; } > "$log"
  [ "$istate" = done ] || rc=1
else
# own process group (set -m, only for this launch) so timeout and interrupt can signal the whole tree with kill -- -$wpid
set -m; ( cd "$wd" && exec "${cmd[@]}" </dev/null ) > "$log" 2>&1 &
wpid=$!; set +m
[ -z "$slot" ] || echo "$wpid" > "$slot/wpid" 2>/dev/null # lets the slot stay counted if spawn is kill -9ed while the worker runs
guard=
if [ "$TMO" -gt 0 ] 2>/dev/null; then
  ( sleep "$TMO"; kill -0 "$wpid" 2>/dev/null || exit 0; : > "$T/run/$id.timedout"; kill -TERM -- "-$wpid" 2>/dev/null; kill -TERM "$wpid" 2>/dev/null; sleep 5; kill -KILL -- "-$wpid" 2>/dev/null; kill -KILL "$wpid" 2>/dev/null ) >/dev/null 2>&1 &
  guard=$!
fi
wait "$wpid"; rc=$?; wpid=""
if [ -n "$guard" ]; then pkill -P "$guard" 2>/dev/null; kill "$guard" 2>/dev/null; wait "$guard" 2>/dev/null; fi
fi
state=done; [ $rc -eq 0 ] || state=failed
[ -f "$T/run/$id.timedout" ] && state=timeout
[ $imode != 1 ] || [ "${istate:-}" != done ] || state=done
if [ ! -s "$hf" ]; then
  [ $state = done ] && state=failed
  { echo "# $id (auto-generated)"
    if [ $state = timeout ]; then echo "status: timed out after ${TMO}s (no handoff written). Last output:"; else echo "status: no handoff written (exit $rc). Last output:"; fi
    tail -n 20 "$log"; } > "$hf"
fi
after=$(snap)
if [ $shape = scout ] && [ "$before" != "$after" ] && [ $state = done ]; then
  # in a tab a human may type too, so interactive mode can only warn
  if [ $imode = 1 ]; then "$here/ledger" -t "$task" spawn "$id scout changed files" "interactive tab; a person may have typed" "$hf" warning 2>/dev/null || true
  else state=violation; fi
fi
# tally the worker's own checklist from its handoff: closed/total, or missing
cl=; [ $state != done ] || cl=$(awk '/^## Checklist/{f=1;next} /^## /{f=0} f && /^[[:space:]]*[-*] \[/' "$hf" 2>/dev/null)
if [ $state != done ]; then :
elif [ -n "$cl" ]; then
  ctot=$(printf '%s\n' "$cl" | wc -l | tr -d ' '); cdone=$(printf '%s\n' "$cl" | grep -c -E '^[[:space:]]*[-*] \[[xX-]\]')
  echo "$cdone/$ctot" > "$T/run/$id.checklist"; echo "checklist: $cdone/$ctot"
  [ "$cdone" -eq "$ctot" ] || echo "spawn: $id checklist has open items ($cdone/$ctot); read $hf" >&2
else
  echo "missing" > "$T/run/$id.checklist"; echo "spawn: $id checklist missing from handoff $hf" >&2
fi
echo "$state $rc $(date +%s)" > "$st"
[ $state = done ] || { echo "spawn: $id $state (exit $rc); handoff $hf" >&2; tail -n 5 "$log" >&2; }
if [ $imode = 1 ]; then
  idone=1
  if [ $state = done ]; then
    [ "${DEVKIT_VIEW_NOTIFY:-}" != all ] || herdr notification show "$id done" --body "$cli $shape: $hf" --sound done >/dev/null 2>&1
    if [ -n "${DEVKIT_VIEW_KEEP:-}" ]; then echo "$vtab" > "$T/run/$id.tab"; else sleep "$DEVKIT_VIEW_CLOSE_DELAY"; herdr tab close "$vtab" >/dev/null 2>&1; fi
  else # the stub already holds the pane read; notify, then close so no stale tab is left (KEEP records it for --close-views)
    herdr notification show "$id $state" --body "$cli $shape: $hf" --sound request >/dev/null 2>&1
    if [ -n "${DEVKIT_VIEW_KEEP:-}" ]; then [ -z "$vtab" ] || echo "$vtab" > "$T/run/$id.tab"; elif [ -n "$vtab" ]; then herdr tab close "$vtab" >/dev/null 2>&1; fi
  fi
  vdone=1
elif [ $view = 1 ]; then
  if [ $state = done ]; then
    vreport idle done
    [ "${DEVKIT_VIEW_NOTIFY:-}" != all ] || herdr notification show "$id done" --body "$cli $shape: $hf" --sound done >/dev/null 2>&1
  else
    vreport blocked "$state"
    herdr notification show "$id $state" --body "$cli $shape: $hf" --sound request >/dev/null 2>&1
  fi
  # a headless worker's tab is not interactive; the error goes to the caller and the handoff, so close it on failure too
  if [ -n "${DEVKIT_VIEW_KEEP:-}" ]; then echo "$vtab" > "$T/run/$id.tab"
  else sleep "$DEVKIT_VIEW_CLOSE_DELAY"; herdr tab close "$vtab" >/dev/null 2>&1; fi
  vdone=1
fi
"$here/ledger" -t "$task" spawn "$id $state" "cli=$cli shape=$shape" "$hf" "$state" 2>/dev/null || true
[ $state = done ]
