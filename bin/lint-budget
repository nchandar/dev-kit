#!/usr/bin/env bash
# Enforce dev-kit context budget. Usage: bin/lint-budget [root] [--partial]
# --partial skips the minimum-skill-count check (use while building up).
set -u
root=.; partial=0
for a in "$@"; do case $a in --partial) partial=1;; *) root=$a;; esac; done
cd "$root" || exit 2

# SKILLS_MAX 8 -> 12: the playbook split made 9 skills
AGENTS_MAX=6144 DESC_MAX=4096 SKILL_LINES=150 LIB_LINES=80 SKILLS_MIN=4 SKILLS_MAX=12 JACCARD=0.5 LIB_TOTAL=36864 DEEP_LINES=45 DEEP_TOTAL=65536 RECIPE_LINES=45 RECIPE_TOTAL=49152
errs=0
bad() { echo "FAIL $*"; errs=$((errs+1)); } # pitfall-ok: decimal-arith internal counter
section() { grep -Eqi "^##+ +$2" "$1" || bad "$1: missing section '$2'"; }
common() { # every skill and library file: ledger line, no escaping the tree, resolvable library refs
  grep -q 'bin/ledger' "$1" || bad "$1: must mention bin/ledger"
  grep -Eq '\.\./|references/' "$1" && bad "$1: references files outside the tree"
  local r; for r in $(grep -oE 'library/(deep/|recipes/)?[a-z0-9-]+' "$1" | grep -v -x -E 'library/(deep|recipes)' | sort -u); do
    [ -f "$r.md" ] || bad "$1: unresolved reference $r"; done; }

sz=$(wc -c < AGENTS.md 2>/dev/null || echo 0)
[ "$sz" -le $AGENTS_MAX ] || bad "AGENTS.md is $sz B (max $AGENTS_MAX)"

shopt -s nullglob
skills=(skills/*/SKILL.md); n=${#skills[@]}
[ "$n" -le $SKILLS_MAX ] || bad "$n skills (max $SKILLS_MAX)"
[ "$partial" = 1 ] || [ "$n" -ge $SKILLS_MIN ] || bad "$n skills (min $SKILLS_MIN)"

total=0; descs=""
for f in "${skills[@]}"; do
  lines=$(wc -l < "$f")
  [ "$lines" -le $SKILL_LINES ] || bad "$f has $lines lines (max $SKILL_LINES)"
  fm=$(awk 'NR==1&&$0!="---"{exit} NR>1&&$0=="---"{exit} NR>1{print}' "$f")
  nm=$(printf '%s\n' "$fm" | sed -n 's/^name:[[:space:]]*//p' | head -1)
  folder=$(basename "$(dirname "$f")")
  [[ $nm =~ ^dev-[a-z0-9-]+$ ]] || bad "$f: name '$nm' must start with dev-"
  [ "$nm" = "$folder" ] || bad "$f: name '$nm' must equal folder '$folder'"
  d=$(printf '%s\n' "$fm" | grep -m1 '^description:' | sed 's/^description:[[:space:]]*//')
  if [ -z "$d" ] || [[ $d == ">"* ]] || [[ $d == "|"* ]]; then bad "$f: description must be one non-empty line"
  else
    nxt=$(printf '%s\n' "$fm" | awk '/^description:/{f=1;next} f{print;exit}')
    [[ $nxt == [[:space:]]* ]] && bad "$f: description spans multiple lines"
    total=$((total + ${#d} + 1)); descs+="$f	$d"$'\n' # pitfall-ok: decimal-arith internal counter plus string length
  fi
  common "$f"
  [ "$nm" = dev-learn ] || grep -q 'library/state' "$f" || bad "$f: must reference library/state (closeout)"
  for h in "When to Use" "Checklist" "Rationalizations" "Red Flags" "Verification"; do section "$f" "$h"; done
done
[ "$total" -le $DESC_MAX ] || bad "descriptions total $total B (max $DESC_MAX)"

libs=(library/*.md); ln=${#libs[@]}; libbytes=0
for f in "${libs[@]}"; do
  lines=$(wc -l < "$f"); libbytes=$((libbytes + $(wc -c < "$f"))) # pitfall-ok: decimal-arith wc output, always decimal
  [ "$lines" -le $LIB_LINES ] || bad "$f has $lines lines (max $LIB_LINES)"
  common "$f"
  for h in "When to Use" "Steps" "Red Flags" "Verification"; do section "$f" "$h"; done
done

# library/deep: the on-demand long tail. Never auto-loaded, so it gets its own caps and lighter sections.
deepf=(library/deep/*.md); dn=${#deepf[@]}; deepbytes=0
for f in ${deepf[@]+"${deepf[@]}"}; do
  lines=$(wc -l < "$f"); deepbytes=$((deepbytes + $(wc -c < "$f"))) # pitfall-ok: decimal-arith wc output, always decimal
  [ "$lines" -le $DEEP_LINES ] || bad "$f has $lines lines (max $DEEP_LINES)"
  grep -Eq '\.\./|references/' "$f" && bad "$f: references files outside the tree"
  for h in "When to Load" "Red Flags"; do section "$f" "$h"; done
  for r in $(grep -oE 'library/(deep/|recipes/)?[a-z0-9-]+' "$f" | grep -v -x -E 'library/(deep|recipes)' | sort -u); do [ -f "$r.md" ] || bad "$f: unresolved reference $r"; done
done
[ "$deepbytes" -le $DEEP_TOTAL ] || bad "library/deep totals $deepbytes B (max $DEEP_TOTAL)"

# library/recipes: reusable procedures learned in real work. On demand, indexed, never auto-loaded.
recf=(library/recipes/*.md); rn=0; recbytes=0
for f in ${recf[@]+"${recf[@]}"}; do
  name=$(basename "$f" .md); [ "$name" = index ] && continue
  rn=$((rn + 1)); lines=$(wc -l < "$f"); recbytes=$((recbytes + $(wc -c < "$f"))) # pitfall-ok: decimal-arith internal counter plus wc output
  [ "$lines" -le $RECIPE_LINES ] || bad "$f has $lines lines (max $RECIPE_LINES)"
  grep -Eq '\.\./|references/' "$f" && bad "$f: references files outside the tree"
  for h in "When to Load" "Steps" "Gotchas" "Verified"; do section "$f" "$h"; done
  for r in $(grep -oE 'library/(deep/|recipes/)?[a-z0-9-]+' "$f" | grep -v -x -E 'library/(deep|recipes)' | sort -u); do [ -f "$r.md" ] || bad "$f: unresolved reference $r"; done
  grep -q "^$name:" library/recipes/index.md 2>/dev/null || bad "$f: not listed in library/recipes/index.md"
done
if [ -f library/recipes/index.md ]; then
  for e in $(grep -oE '^[a-z0-9-]+:' library/recipes/index.md | tr -d ':'); do [ -f "library/recipes/$e.md" ] || bad "library/recipes/index.md lists $e but the file is missing"; done
fi
[ "$recbytes" -le $RECIPE_TOTAL ] || bad "library/recipes totals $recbytes B (max $RECIPE_TOTAL)"

[ "$libbytes" -le $LIB_TOTAL ] || bad "library totals $libbytes B (max $LIB_TOTAL): compress before adding"

# trigger collision: Jaccard over content words of each listed description pair
if [ -n "$descs" ]; then
  printf '%s' "$descs" | awk -F'\t' -v thr=$JACCARD '
    BEGIN{split("the and for with when use that this from into your are not any all can has have its then than will you them they what which while where been being were these those also only each such over after before",s," "); for(i in s)stop[s[i]]=1}
    { names[NR]=$1; k=split(tolower($2),w,/[^a-z0-9]+/)
      for(i=1;i<=k;i++) if(length(w[i])>=4 && !(w[i] in stop)) set[NR,w[i]]=1 }
    END{ for(a=1;a<=NR;a++) for(b=a+1;b<=NR;b++){ inter=0; ua=0; ub=0
        for(key in set){ split(key,p,SUBSEP); if(p[1]==a){ua++; if((b SUBSEP p[2]) in set) inter++} else if(p[1]==b) ub++ }
        un=ua+ub-inter; if(un>0 && inter/un>=thr){ printf "FAIL trigger collision %.2f: %s <-> %s\n", inter/un, names[a], names[b]; c++ } }
      exit c>0 }' || errs=$((errs+1)) # pitfall-ok: decimal-arith internal counter
fi

# public-safety: this repo is public, so no home paths, emails or secret-shaped strings in it.
# Tracked files only: a local .env or other ignored file must never be read or echoed, and a
# finding prints file:line plus the pattern class, never the matched text.
LEAK_CLASSES='home_path email github_token api_key aws_key_id private_key'
leak_re() { case $1 in
  home_path) printf '%s' '/Users/[A-Za-z0-9._-]+|/home/[A-Za-z0-9._-]+';;
  email) printf '%s' '[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}';;
  github_token) printf '%s' 'gh[pousr]_[A-Za-z0-9]{20,}';;
  api_key) printf '%s' 'sk-[A-Za-z0-9]{20,}';;
  aws_key_id) printf '%s' 'AKIA[0-9A-Z]{16}';;
  private_key) printf '%s' '-----BEGIN [A-Z ]*PRIVATE KEY-----';;
esac; }
in_git=0; git rev-parse --is-inside-work-tree >/dev/null 2>&1 && in_git=1
leaks=""
for c in $LEAK_CLASSES; do
  re=$(leak_re "$c")
  if [ "$in_git" -eq 1 ]; then hits=$(git grep -I -n -o -E -e "$re" -- . 2>/dev/null)
  else hits=$(grep -rIno -E -e "$re" . --exclude-dir=.git --exclude-dir=.devkit 2>/dev/null)
  fi
  [ -n "$hits" ] || continue
  # allowed addresses are the only matches whose text is inspected; then the text is dropped
  hits=$(printf '%s\n' "$hits" | grep -v -E '@(example\.com|users\.noreply\.github\.com)$' | grep -v -E '(^|/)(lint-budget|lint-budget\.test\.sh):[0-9]+:')
  [ -n "$hits" ] || continue
  leaks="$leaks$(printf '%s\n' "$hits" | sed -E 's/^([^:]+:[0-9]+):.*/\1/' | sed "s/$/: $c/")
"
done
[ -z "$leaks" ] || { printf '%s' "$leaks" | sort -u | head -8 | sed 's/^/FAIL public-safety: /'; errs=$((errs+1)); } # pitfall-ok: decimal-arith internal counter

if [ $errs -eq 0 ]; then echo "OK: AGENTS.md ${sz}B, $n skills (descriptions ${total}B), $ln library files (${libbytes}B) + $dn deep (${deepbytes}B) + $rn recipes (${recbytes}B), on demand"; exit 0; fi
exit 1
