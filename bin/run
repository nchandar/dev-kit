#!/usr/bin/env bash
# Run a command without flooding your context. Full output goes to a log; you get a short summary.
# Usage: bin/run [-n TAIL_LINES] <command> [args...]    (default tail 15). Exit code = the command's.
# Output: line 1 "exit=<rc> secs=<n> log=<path>", then on failure up to 20 error-looking lines and the tail.
set -u
here=$(dirname "$0"); tail_n=15
[ "${1:-}" = -n ] && { tail_n=${2:-15}; shift 2; }
[ $# -ge 1 ] || { echo "usage: run [-n N] <command> [args...]" >&2; exit 2; }
task=${DEVKIT_TASK:-}; [ -n "$task" ] || { echo "run: no task. Run: ledger start <slug>; set DEVKIT_TASK" >&2; exit 2; }
D=$("$here/ledger" -t "$task" path) || exit 2
mkdir -p "$D/runs"
# claim the log name atomically (noclobber), bounded, so parallel runs never share a log
n=$(ls "$D/runs" | wc -l); tries=0
while :; do
  n=$((n+1)); log=$D/runs/$(printf '%03d' "$n").log # pitfall-ok: decimal-arith internal counter, always decimal
  ( set -C; : > "$log" ) 2>/dev/null && break
  tries=$((tries+1)); [ "$tries" -lt 200 ] || { echo "run: cannot claim a log name in $D/runs" >&2; exit 2; } # pitfall-ok: decimal-arith internal counter, always decimal
done
s=$(date +%s); "$@" > "$log" 2>&1 < /dev/null; rc=$?; e=$(date +%s)
printf 'exit=%s secs=%s log=%s\n' "$rc" "$((e-s))" "$log" # pitfall-ok: decimal-arith epoch seconds, always decimal
if [ $rc -ne 0 ]; then
  grep -n -i -E 'fail|error|panic|assert|exception|traceback|✗|not ok' "$log" | cut -c1-200 | head -20
  echo "--- last $tail_n lines:"; tail -n "$tail_n" "$log" | cut -c1-200
fi
"$here/ledger" -t "$task" run "$(printf '%s ' "$@" | cut -c1-80)" "exit $rc in $((e-s))s" "$log" "$([ $rc -eq 0 ] && echo pass || echo fail)" 2>/dev/null || true # pitfall-ok: decimal-arith rc from $?, always decimal
exit $rc
