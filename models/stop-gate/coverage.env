# Stop hook accept protocol: six rules over bin/stop-gate, reconcile and spawn rows,
# including the tracked-waiter pass and its wake.
# bounds: 3 workers, 2 runs per id, MAXBLOCKS=3. Pane/idle paths, kill -9 beyond
# Kill9 and payload parsing are excluded; see README.md
# "What the timing exclusions leave out".
sync=1fc92340ff9c7b41a53dfd7db0ffc4520b96bf54
files=bin/stop-gate bin/reconcile bin/spawn bin/ledger
cmd=models/stop-gate/run.sh
